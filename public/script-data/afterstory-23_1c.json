{"route":"afterstory","routeLabel":"AfterStory","scriptId":"afterstory-23_1c","lineCount":105,"lines":[{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00000","sourceRef":"oretsuba-afterstory:23_1c:full-00000","line":1,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「鳴ちゃーん……」","english":"“Naruuu...”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00001","sourceRef":"oretsuba-afterstory:23_1c:full-00001","line":2,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「えー？　なにー、亜衣ちゃん……」","english":"“Whaaat, Aiii...?”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00002","sourceRef":"oretsuba-afterstory:23_1c:full-00002","line":3,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「個別課題、あと二日だねえ……」","english":"“Two days left on the individual assignment...”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00003","sourceRef":"oretsuba-afterstory:23_1c:full-00003","line":4,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「あと二日だねえ……」","english":"“Two days left...”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00004","sourceRef":"oretsuba-afterstory:23_1c:full-00004","line":5,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「やっぱバガりながらはダメだったね……」","english":"“Trying to do it over burgers didn’t work after all...”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00005","sourceRef":"oretsuba-afterstory:23_1c:full-00005","line":6,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「そりゃーそうだろってカンジだけどねー……」","english":"“Yeah, which was kinda obvious from the start...”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00006","sourceRef":"oretsuba-afterstory:23_1c:full-00006","line":7,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あんなにも雑談に花が咲く環境だとはなぁ」","english":"“Who knew it would be such a fertile environment for conversation?”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00007","sourceRef":"oretsuba-afterstory:23_1c:full-00007","line":8,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「はぁー、あと二日かー……」","english":"“Sigh. Two days left...”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00008","sourceRef":"oretsuba-afterstory:23_1c:full-00008","line":9,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あんさー」","english":"“Hey...”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00009","sourceRef":"oretsuba-afterstory:23_1c:full-00009","line":10,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「んー？」","english":"“Mmm?”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00010","sourceRef":"oretsuba-afterstory:23_1c:full-00010","line":11,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「ぶっちゃけもう無理じゃね？」","english":"“Honestly, aren’t we already screwed?”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00011","sourceRef":"oretsuba-afterstory:23_1c:full-00011","line":12,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「いやー、全力出せばまだ間に合うでしょー」","english":"“Nah, we can still make it if we go all out.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00012","sourceRef":"oretsuba-afterstory:23_1c:full-00012","line":13,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「うーん……ま、そうかもねー」","english":"“Hmm... Yeah, maybe.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00013","sourceRef":"oretsuba-afterstory:23_1c:full-00013","line":14,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「そうそう、全力出せばねー」","english":"“Right. If we go all out.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00014","sourceRef":"oretsuba-afterstory:23_1c:full-00014","line":15,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00015","sourceRef":"oretsuba-afterstory:23_1c:full-00015","line":16,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00016","sourceRef":"oretsuba-afterstory:23_1c:full-00016","line":17,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「鳴ちゃーん……」","english":"“Naruuu...”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00017","sourceRef":"oretsuba-afterstory:23_1c:full-00017","line":18,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「えー？　なにー、亜衣ちゃん……」","english":"“Whaaat, Aiii...?”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00018","sourceRef":"oretsuba-afterstory:23_1c:full-00018","line":19,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「早く出しなよ、全力……」","english":"“Hurry up and go all out...”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00019","sourceRef":"oretsuba-afterstory:23_1c:full-00019","line":20,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「やー、亜衣ちゃん先出していいってー」","english":"“No, no, you can go all out first.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00020","sourceRef":"oretsuba-afterstory:23_1c:full-00020","line":21,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あれ、言ってなかったっけ。私、スロースターター」","english":"“Didn’t I tell you? I’m a slow starter.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00021","sourceRef":"oretsuba-afterstory:23_1c:full-00021","line":22,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「あー、私もー。脚質、追い込みー」","english":"“Oh, me too. I’m a closer.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00022","sourceRef":"oretsuba-afterstory:23_1c:full-00022","line":23,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「だったら、もう第四コーナーまわってるから仕掛けた方がいいって」","english":"“Then you should make your move. We’re already around the final turn.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00023","sourceRef":"oretsuba-afterstory:23_1c:full-00023","line":24,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「だいじょぶ。末脚の伸び、すっごいから私」","english":"“It’s fine. My finishing kick is incredible.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00024","sourceRef":"oretsuba-afterstory:23_1c:full-00024","line":25,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「つったって、まだゲート出てなくね？」","english":"“You haven’t even left the gate.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00025","sourceRef":"oretsuba-afterstory:23_1c:full-00025","line":26,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「出てるってー。もうノート半ページはやったもん」","english":"“I have. I did a whole half page.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00026","sourceRef":"oretsuba-afterstory:23_1c:full-00026","line":27,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「少なっ！」","english":"“That’s nothing!”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00027","sourceRef":"oretsuba-afterstory:23_1c:full-00027","line":28,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「えー、亜衣ちゃんはー？」","english":"“What about you, Ai?”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00028","sourceRef":"oretsuba-afterstory:23_1c:full-00028","line":29,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「まあ、そーね……４～５ページ、ぐらい？」","english":"“Well, let’s see... Maybe four or five pages?”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00029","sourceRef":"oretsuba-afterstory:23_1c:full-00029","line":30,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「すごーい」","english":"“Amazing.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00030","sourceRef":"oretsuba-afterstory:23_1c:full-00030","line":31,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「すごいべー？」","english":"“Pretty amazing, huh?”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00031","sourceRef":"oretsuba-afterstory:23_1c:full-00031","line":32,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「ほんとはー？」","english":"“And the truth?”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00032","sourceRef":"oretsuba-afterstory:23_1c:full-00032","line":33,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「半ページぐらい」","english":"“About half a page.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00033","sourceRef":"oretsuba-afterstory:23_1c:full-00033","line":34,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「わー、どんぐりの背比べー」","english":"“Wow, we’re neck and neck.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00034","sourceRef":"oretsuba-afterstory:23_1c:full-00034","line":35,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「てゆか、ドン尻の背比べ？」","english":"“More like wreck and wreck.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00035","sourceRef":"oretsuba-afterstory:23_1c:full-00035","line":36,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「上手ーい」","english":"“Nice.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00036","sourceRef":"oretsuba-afterstory:23_1c:full-00036","line":37,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「上手いべー？」","english":"“Pretty nice, huh?”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00037","sourceRef":"oretsuba-afterstory:23_1c:full-00037","line":38,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「すなわちやばーい」","english":"“Meaning we’re screwed.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00038","sourceRef":"oretsuba-afterstory:23_1c:full-00038","line":39,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「うん、やばいよね、いよいよ」","english":"“Yeah. We’re finally seriously screwed.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00039","sourceRef":"oretsuba-afterstory:23_1c:full-00039","line":40,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「あと二日だもんねー、いよいよ」","english":"“Only two days left. Finally.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00040","sourceRef":"oretsuba-afterstory:23_1c:full-00040","line":41,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00041","sourceRef":"oretsuba-afterstory:23_1c:full-00041","line":42,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00042","sourceRef":"oretsuba-afterstory:23_1c:full-00042","line":43,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「おっかしーなー、いままで何やってたんだろ」","english":"“This is weird. What have we been doing all this time?”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00043","sourceRef":"oretsuba-afterstory:23_1c:full-00043","line":44,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「だよねー？　けっこー頑張ってたよね、私ら」","english":"“Right? We’ve been trying pretty hard.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00044","sourceRef":"oretsuba-afterstory:23_1c:full-00044","line":45,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「だしょー？　放課後残ったり、バガりながらノート広げたり、頑張っただしょー？」","english":"“Exactly. Staying after school, opening our notebooks over burgers. We tried hard, right?”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00045","sourceRef":"oretsuba-afterstory:23_1c:full-00045","line":46,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「悲しいなー、報われない努力ってあるんだねー」","english":"“It’s so sad. I guess some efforts just go unrewarded.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00046","sourceRef":"oretsuba-afterstory:23_1c:full-00046","line":47,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「つっても、やるだけやったんだし、先生も分かってくれんじゃないかな」","english":"“Still, we did everything we could. Maybe the teacher will understand.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00047","sourceRef":"oretsuba-afterstory:23_1c:full-00047","line":48,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「まーまー、情状酌量の余地はあって然るべきだよねー」","english":"“Right, right. There ought to be extenuating circumstances.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00048","sourceRef":"oretsuba-afterstory:23_1c:full-00048","line":49,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「もしこれで許されなかったら、いまこの瞬間の頑張ってる私ら、ちょお可哀そくね？」","english":"“If we don’t get let off, wouldn’t that be so unfair to us when we’re working this hard right now?”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00049","sourceRef":"oretsuba-afterstory:23_1c:full-00049","line":50,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「ほんとー。しかもソレって、いままでの血の滲むような努力もぜんぶ無駄になるってことでしょー？」","english":"“Exactly. Plus, it would mean all our blood-soaked efforts up to now were for nothing.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00050","sourceRef":"oretsuba-afterstory:23_1c:full-00050","line":51,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「なにそれ鬼じゃん……ありえなーい……」","english":"“What kind of monster would do that...? Unbelievable...”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00051","sourceRef":"oretsuba-afterstory:23_1c:full-00051","line":52,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「世知辛い時代だねー」","english":"“Cruel times we live in.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00052","sourceRef":"oretsuba-afterstory:23_1c:full-00052","line":53,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あーも、超セツい。今日やる気でなーい……」","english":"“Ugh, this is so depressing. I can’t get motivated today.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00053","sourceRef":"oretsuba-afterstory:23_1c:full-00053","line":54,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「うんー、なんかこう、入らないよね……」","english":"“Yeah. It just won’t go in.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00054","sourceRef":"oretsuba-afterstory:23_1c:full-00054","line":55,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「入んないねぇ……」","english":"“Won’t go in...”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00055","sourceRef":"oretsuba-afterstory:23_1c:full-00055","line":56,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「上がらないし」","english":"“Can’t get it up.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00056","sourceRef":"oretsuba-afterstory:23_1c:full-00056","line":57,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「上がんないねー」","english":"“Won’t go up.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00057","sourceRef":"oretsuba-afterstory:23_1c:full-00057","line":58,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「降りてこない」","english":"“Inspiration won’t come down.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00058","sourceRef":"oretsuba-afterstory:23_1c:full-00058","line":59,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「降りてこんねー」","english":"“Won’t come down.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00059","sourceRef":"oretsuba-afterstory:23_1c:full-00059","line":60,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「やっぱり今日、なんか違うよねいつもと」","english":"“Something really is different today.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00060","sourceRef":"oretsuba-afterstory:23_1c:full-00060","line":61,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「分かる、違うかもー」","english":"“I know. Something feels different.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00061","sourceRef":"oretsuba-afterstory:23_1c:full-00061","line":62,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「モチベーションが維持できないっていうか？　コンセントレーションが乱れるっていうの？」","english":"“Like we can’t maintain our motivation? Our concentration is disturbed?”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00062","sourceRef":"oretsuba-afterstory:23_1c:full-00062","line":63,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「なんかがスーッて抜けちゃったカンジ」","english":"“Feels like something just drained right out of me.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00063","sourceRef":"oretsuba-afterstory:23_1c:full-00063","line":64,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「昨日までの自分がここにいないよね」","english":"“The girls we were yesterday aren’t here anymore.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00064","sourceRef":"oretsuba-afterstory:23_1c:full-00064","line":65,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「どゆことコレ。風水的にアレなのかな」","english":"“What does this mean? Is the feng shui wrong?”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00065","sourceRef":"oretsuba-afterstory:23_1c:full-00065","line":66,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「やー、バイオリズムの変調期かも」","english":"“Maybe our biorhythms are in flux.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00066","sourceRef":"oretsuba-afterstory:23_1c:full-00066","line":67,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「もしか身体的な問題かな。え、どーする、いまから病院行く？」","english":"“Could be a physical problem. What do we do? Go to the hospital?”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00067","sourceRef":"oretsuba-afterstory:23_1c:full-00067","line":68,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「行きたーい、けど課題どうするー？」","english":"“I want to, but what about the assignment?”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00068","sourceRef":"oretsuba-afterstory:23_1c:full-00068","line":69,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あ、そっか、そんなんまだ残ってたっけ」","english":"“Oh, right. That still existed.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00069","sourceRef":"oretsuba-afterstory:23_1c:full-00069","line":70,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「残ってるんだけどさー、なんか私、最近筆の進みが悪くなっちゃってー」","english":"“It does, but my pen hasn’t been moving well lately.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00070","sourceRef":"oretsuba-afterstory:23_1c:full-00070","line":71,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あっ、私も私も。なんてゆーの、いよいよ壁に当たったカンジ？」","english":"“Oh! Me too, me too. What do you call it? Feels like I finally hit a wall.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00071","sourceRef":"oretsuba-afterstory:23_1c:full-00071","line":72,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「そーそ、スランプって感じー」","english":"“Right, right. Like a slump.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00072","sourceRef":"oretsuba-afterstory:23_1c:full-00072","line":73,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「最初に飛ばしすぎちゃったかなー。うん、いわゆる燃え尽き症候群ってゆーの？」","english":"“Maybe we went too hard at the beginning. You know, burnout syndrome?”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00073","sourceRef":"oretsuba-afterstory:23_1c:full-00073","line":74,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「私も情熱の枯渇を感じてるんだー。すでに全部出しきっちゃった感は否めないよねー」","english":"“I feel my passion running dry too. Can’t deny the feeling that I already gave it everything.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00074","sourceRef":"oretsuba-afterstory:23_1c:full-00074","line":75,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「ハア、正直もう疲れちゃった。たまには勉強のことなんか忘れてごろごろしたいな」","english":"“Sigh. Honestly, I’m tired. Just once, I wanna forget studying and lie around.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00075","sourceRef":"oretsuba-afterstory:23_1c:full-00075","line":76,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「はー、課題という名の過酷な運命はいつになったら私を解放してくれるのかなー」","english":"“Sigh. When will this cruel destiny called an assignment finally release me?”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00076","sourceRef":"oretsuba-afterstory:23_1c:full-00076","line":77,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「そっかあ。うちらの課題が進まないの、運命的な、あのアレ、神のいたずらだ」","english":"“I see. Our assignment won’t move because of destiny. It’s that thing. A prank by God.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00077","sourceRef":"oretsuba-afterstory:23_1c:full-00077","line":78,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「菅原のいたずらか」","english":"“A prank by Sugawara.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00078","sourceRef":"oretsuba-afterstory:23_1c:full-00078","line":79,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「やーん、ちょっとさー、最近スガぴー調子こいてない？」","english":"“Hey, hasn’t Suga-P been getting a little cocky lately?”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00079","sourceRef":"oretsuba-afterstory:23_1c:full-00079","line":80,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「じゃーあとでシメとくー」","english":"“Yeah. I’ll rough him up later.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00080","sourceRef":"oretsuba-afterstory:23_1c:full-00080","line":81,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「はあ、解決」","english":"“Whew, solved.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00081","sourceRef":"oretsuba-afterstory:23_1c:full-00081","line":82,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「はー」","english":"“Sigh.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00082","sourceRef":"oretsuba-afterstory:23_1c:full-00082","line":83,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00083","sourceRef":"oretsuba-afterstory:23_1c:full-00083","line":84,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00084","sourceRef":"oretsuba-afterstory:23_1c:full-00084","line":85,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「鳴ちゃーん」","english":"“Naruuu.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00085","sourceRef":"oretsuba-afterstory:23_1c:full-00085","line":86,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「えー？　なにー、亜衣ちゃん」","english":"“Whaaat, Aiii?”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00086","sourceRef":"oretsuba-afterstory:23_1c:full-00086","line":87,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「そろそろ始めるー？」","english":"“Should we start soon?”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00087","sourceRef":"oretsuba-afterstory:23_1c:full-00087","line":88,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「あー、そうだねー」","english":"“Oh, yeah.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00088","sourceRef":"oretsuba-afterstory:23_1c:full-00088","line":89,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「さすがに潮時だよねー」","english":"“It is about time.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00089","sourceRef":"oretsuba-afterstory:23_1c:full-00089","line":90,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「んー、じゃー、あと五分したら開始ー」","english":"“Okay. We start in five minutes.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00090","sourceRef":"oretsuba-afterstory:23_1c:full-00090","line":91,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「おっけてぃんぐー」","english":"“Okey-dokey.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00091","sourceRef":"oretsuba-afterstory:23_1c:full-00091","line":92,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00092","sourceRef":"oretsuba-afterstory:23_1c:full-00092","line":93,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00093","sourceRef":"oretsuba-afterstory:23_1c:full-00093","line":94,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「鳳ぃー」","english":"“Ohtoriii.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00094","sourceRef":"oretsuba-afterstory:23_1c:full-00094","line":95,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「えー？　なに香田ぁー」","english":"“Whaaat, Koudaaa?”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00095","sourceRef":"oretsuba-afterstory:23_1c:full-00095","line":96,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「とりまＴ行ってリフレッシュでもしない？」","english":"“Wanna hit the ladies’ room and freshen up first?”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00096","sourceRef":"oretsuba-afterstory:23_1c:full-00096","line":97,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「おトイレさん参りっすかー、いっすねー」","english":"“A pilgrimage to the porcelain shrine? Sounds good.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00097","sourceRef":"oretsuba-afterstory:23_1c:full-00097","line":98,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「そろそろ休憩入れる時間だしさ、軽く息抜きがてら」","english":"“It’s about time for a break anyway. A quick breather.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00098","sourceRef":"oretsuba-afterstory:23_1c:full-00098","line":99,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「お手洗いは乙女の身近な隠れ家スポットだよねー」","english":"“The ladies’ room is every girl’s neighborhood hideaway.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00099","sourceRef":"oretsuba-afterstory:23_1c:full-00099","line":100,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「頑張った自分にご褒美だよねー」","english":"“A reward for all our hard work.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00100","sourceRef":"oretsuba-afterstory:23_1c:full-00100","line":101,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「小川のせせらぎに癒されようツアー」","english":"“A soothing tour of the babbling brook.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00101","sourceRef":"oretsuba-afterstory:23_1c:full-00101","line":102,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「え、鳴ちゃんナイアガラでしょ」","english":"“Please, Naru, you’re Niagara Falls.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00102","sourceRef":"oretsuba-afterstory:23_1c:full-00102","line":103,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「わー、下品を通りこして名誉棄損ー」","english":"“Wow. We went past vulgar and straight into defamation.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00103","sourceRef":"oretsuba-afterstory:23_1c:full-00103","line":104,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「だって、翔さんが言ってたよ？」","english":"“That’s what Kakeru said.”"},{"ref":"oretsuba:afterstory:afterstory-23_1c:full-00104","sourceRef":"oretsuba-afterstory:23_1c:full-00104","line":105,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「もアイツ殺していいよ」","english":"“Ugh, you can kill him for all I care.”"}]}

{"route":"prelude","routeLabel":"Prelude","scriptId":"prelude-03_03j1","lineCount":11,"lines":[{"ref":"oretsuba:prelude:prelude-03_03j1:00000c46","sourceRef":"oretsuba-prelude:03_03j1:00000c46","line":1,"speakerJa":"隼人","speakerEn":"Hayato","japanese":"「ああ……あー、まー、それは……あるかもな」","english":"“Ahh... Ah, well, that... might happen.”"},{"ref":"oretsuba:prelude:prelude-03_03j1:00000c1b","sourceRef":"oretsuba-prelude:03_03j1:00000c1b","line":2,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「あるかもですね」","english":"“It might.”"},{"ref":"oretsuba:prelude:prelude-03_03j1:00000bfa","sourceRef":"oretsuba-prelude:03_03j1:00000bfa","line":3,"speakerJa":"","speakerEn":"","japanese":"そうかもな、と俺は言った。","english":"It might, I said."},{"ref":"oretsuba:prelude:prelude-03_03j1:00000bd5","sourceRef":"oretsuba-prelude:03_03j1:00000bd5","line":4,"speakerJa":"","speakerEn":"","japanese":"そうですよね、とやつも言った。","english":"Right, she said."},{"ref":"oretsuba:prelude:prelude-03_03j1:00000bb0","sourceRef":"oretsuba-prelude:03_03j1:00000bb0","line":5,"speakerJa":"","speakerEn":"","japanese":"なるほどね、とふたりで言った。","english":"I see, we both said."},{"ref":"oretsuba:prelude:prelude-03_03j1:00000b8d","sourceRef":"oretsuba-prelude:03_03j1:00000b8d","line":6,"speakerJa":"","speakerEn":"","japanese":"だから何だ、と誰かが言った。","english":"So what, someone said."},{"ref":"oretsuba:prelude:prelude-03_03j1:00000b4f","sourceRef":"oretsuba-prelude:03_03j1:00000b4f","line":7,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「えー、はい、それではまた近いうちに」","english":"“Well, yes, then I’ll see you again soon.”"},{"ref":"oretsuba:prelude:prelude-03_03j1:00000b33","sourceRef":"oretsuba-prelude:03_03j1:00000b33","line":8,"speakerJa":"隼人","speakerEn":"Hayato","japanese":"「ん。じゃーな」","english":"“Mm. See you.”"},{"ref":"oretsuba:prelude:prelude-03_03j1:00000af6","sourceRef":"oretsuba-prelude:03_03j1:00000af6","line":9,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「はい、それでは、また近いうちにー」","english":"“Yes, then I’ll see you again soooon.”"},{"ref":"oretsuba:prelude:prelude-03_03j1:00000aac","sourceRef":"oretsuba-prelude:03_03j1:00000aac","line":10,"speakerJa":"隼人","speakerEn":"Hayato","japanese":"「繰りかえさないでいいから。ほら、早く行け。いい席なくなんぞ」","english":"“Don’t need to repeat it. Come on, go. All the good seats’ll be gone.”"},{"ref":"oretsuba:prelude:prelude-03_03j1:00000a7b","sourceRef":"oretsuba-prelude:03_03j1:00000a7b","line":11,"speakerJa":"","speakerEn":"","japanese":"たぶんこいつは車両の連結部を好むタイプだ。","english":"She was probably the type who preferred the space between the cars."}]}

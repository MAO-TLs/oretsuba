{"route":"afterstory","routeLabel":"AfterStory","scriptId":"afterstory-14_6a1","lineCount":3,"lines":[{"ref":"oretsuba:afterstory:afterstory-14_6a1:full-00000","sourceRef":"oretsuba-afterstory:14_6a1:full-00000","line":1,"speakerJa":"鷹志","speakerEn":"Takashi","japanese":"「まあ強いて選ぶならこれだな」","english":"“If I have to choose, I guess this one.”"},{"ref":"oretsuba:afterstory:afterstory-14_6a1:full-00001","sourceRef":"oretsuba-afterstory:14_6a1:full-00001","line":2,"speakerJa":"蔵人","speakerEn":"Kuroudo","japanese":"「痴漢モノねェ、おまえ通学中にヘンな欲求でも溜まってんじゃねえの」","english":"“Molestation, huh? Your commute giving you some weird urges?”"},{"ref":"oretsuba:afterstory:afterstory-14_6a1:full-00002","sourceRef":"oretsuba-afterstory:14_6a1:full-00002","line":3,"speakerJa":"鷹志","speakerEn":"Takashi","japanese":"「あんたが選ばせたんだよ」","english":"“You made me choose!”"}]}

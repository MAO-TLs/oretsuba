{"route":"afterstory","routeLabel":"AfterStory","scriptId":"afterstory-23_1d","lineCount":97,"lines":[{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00000","sourceRef":"oretsuba-afterstory:23_1d:full-00000","line":1,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「はー、お待たせー」","english":"“Whew, sorry to keep you waiting.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00001","sourceRef":"oretsuba-afterstory:23_1d:full-00001","line":2,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「ほいよ。鳴ちゃん、手ぇ洗った？」","english":"“No problem. Naru, did you wash your hands?”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00002","sourceRef":"oretsuba-afterstory:23_1d:full-00002","line":3,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「洗ったよー。ていうか、わざわざ聞くなー？　洗わなかったことなんか一度もないぞー？」","english":"“I did. And why do you have to ask? I’ve never not washed them in my life.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00003","sourceRef":"oretsuba-afterstory:23_1d:full-00003","line":4,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「ハンカチ、私ので良ければ」","english":"“You can use my handkerchief if you need one.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00004","sourceRef":"oretsuba-afterstory:23_1d:full-00004","line":5,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「大丈夫だよー。ていうか、自分の持ってるぞー？　なんでカーテンで手ぇ拭くキャラにしたいんだー？」","english":"“I’m fine. I have my own. Why are you so determined to cast me as the girl who wipes her hands on the curtains?”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00005","sourceRef":"oretsuba-afterstory:23_1d:full-00005","line":6,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「はぁ……これで心機一転、心置きなく勉学に打ちこめるよね……」","english":"“Sigh... Now we can make a fresh start and devote ourselves to our studies with nothing hanging over us...”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00006","sourceRef":"oretsuba-afterstory:23_1d:full-00006","line":7,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「はぁ……とても清々しい気分だよね……」","english":"“Sigh... I feel so wonderfully refreshed...”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00007","sourceRef":"oretsuba-afterstory:23_1d:full-00007","line":8,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00008","sourceRef":"oretsuba-afterstory:23_1d:full-00008","line":9,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00009","sourceRef":"oretsuba-afterstory:23_1d:full-00009","line":10,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あのさー……」","english":"“Hey...”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00010","sourceRef":"oretsuba-afterstory:23_1d:full-00010","line":11,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「んー、なにー……」","english":"“Mmm, what...?”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00011","sourceRef":"oretsuba-afterstory:23_1d:full-00011","line":12,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「ないかなぁ……教室戻ったら、小さい菅原が課題ぜんぶ終わらせてるとか……」","english":"“Think there’s any chance... we’ll get back to class and find a tiny Sugawara has done the whole assignment for us...?”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00012","sourceRef":"oretsuba-afterstory:23_1d:full-00012","line":13,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「あー、あるあるー……」","english":"“Oh, totally...”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00013","sourceRef":"oretsuba-afterstory:23_1d:full-00013","line":14,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「んっ？」","english":"“Hm?”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00014","sourceRef":"oretsuba-afterstory:23_1d:full-00014","line":15,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「えー、どしたの亜衣ちゃん、窓の下に菅原でもいたー？」","english":"“What is it, Ai? Did you spot Sugawara under the window?”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00015","sourceRef":"oretsuba-afterstory:23_1d:full-00015","line":16,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「や、さっき鳴ちゃん待ってるあいだ、中庭で付属の子たちがバドミントンしてたんだけど」","english":"“No, while I was waiting for you, I saw some girls from the affiliated school playing badminton in the courtyard.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00016","sourceRef":"oretsuba-afterstory:23_1d:full-00016","line":17,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「うそー、この寒空の下ー？」","english":"“No way. Out in this cold?”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00017","sourceRef":"oretsuba-afterstory:23_1d:full-00017","line":18,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「いまよく見たら、あの子ら──」","english":"“Now that I look closer, those two are—”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00018","sourceRef":"oretsuba-afterstory:23_1d:full-00018","line":19,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「どの子らー？」","english":"“Which two?”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00019","sourceRef":"oretsuba-afterstory:23_1d:full-00019","line":20,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「──キューちゃんと吉川ちゃんだ」","english":"“—Kyuu and Yoshikawa.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00020","sourceRef":"oretsuba-afterstory:23_1d:full-00020","line":21,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「あー、ほんとだー」","english":"“Oh, you’re right.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00021","sourceRef":"oretsuba-afterstory:23_1d:full-00021","line":22,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「なに話してんだろ」","english":"“I wonder what they’re talking about.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00022","sourceRef":"oretsuba-afterstory:23_1d:full-00022","line":23,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「窓開けてみよっかー」","english":"“Wanna open the window?”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00023","sourceRef":"oretsuba-afterstory:23_1d:full-00023","line":24,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「そだね」","english":"“Yeah.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00024","sourceRef":"oretsuba-afterstory:23_1d:full-00024","line":25,"speakerJa":"鳴＋亜衣","speakerEn":"Naru & Ai","japanese":"「寒っ！」","english":"“Cold!”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00025","sourceRef":"oretsuba-afterstory:23_1d:full-00025","line":26,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「こっ、こここここ凍る凍る、ブリザード注意報発令」","english":"“F-f-f-freezing! Blizzard warning in effect!”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00026","sourceRef":"oretsuba-afterstory:23_1d:full-00026","line":27,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あああありえない、ヒトの棲める気温じゃないって。やばいよ、あの子らも早く救出しないと……」","english":"“N-n-no way, humans can’t survive at this temperature. This is bad. We have to rescue those two...”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00027","sourceRef":"oretsuba-afterstory:23_1d:full-00027","line":28,"speakerJa":"小鳩","speakerEn":"Kobato","japanese":"「えへへ、動きまわったから汗かいちゃった」","english":"“Hee-hee, I worked up a sweat from all that running around.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00028","sourceRef":"oretsuba-afterstory:23_1d:full-00028","line":29,"speakerJa":"吉川","speakerEn":"Kikkawa","japanese":"「でも、体ぽかぽかして気持ちいいね」","english":"“But it feels nice being so warm.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00029","sourceRef":"oretsuba-afterstory:23_1d:full-00029","line":30,"speakerJa":"小鳩","speakerEn":"Kobato","japanese":"「うん、ちょっとやすんだら４回戦はじめようか」","english":"“Yeah. Let’s rest a little, then start round four.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00030","sourceRef":"oretsuba-afterstory:23_1d:full-00030","line":31,"speakerJa":"吉川","speakerEn":"Kikkawa","japanese":"「よーし、次は負けないぞー」","english":"“Okay! I won’t lose this time!”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00031","sourceRef":"oretsuba-afterstory:23_1d:full-00031","line":32,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00032","sourceRef":"oretsuba-afterstory:23_1d:full-00032","line":33,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00033","sourceRef":"oretsuba-afterstory:23_1d:full-00033","line":34,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「なんか……」","english":"“There’s something...”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00034","sourceRef":"oretsuba-afterstory:23_1d:full-00034","line":35,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「うん……」","english":"“Yeah...”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00035","sourceRef":"oretsuba-afterstory:23_1d:full-00035","line":36,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「まぶしいね……」","english":"“Dazzling about them...”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00036","sourceRef":"oretsuba-afterstory:23_1d:full-00036","line":37,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「ピュアいね……」","english":"“They’re so pure...”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00037","sourceRef":"oretsuba-afterstory:23_1d:full-00037","line":38,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「透明感ってゆーかー」","english":"“Like, they have this transparency to them.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00038","sourceRef":"oretsuba-afterstory:23_1d:full-00038","line":39,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「天使入ってるよね」","english":"“There’s a little angel in each of them.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00039","sourceRef":"oretsuba-afterstory:23_1d:full-00039","line":40,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「無邪気ってゆーかー」","english":"“They’re so innocent.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00040","sourceRef":"oretsuba-afterstory:23_1d:full-00040","line":41,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「まさしく邪気が無いよね」","english":"“Literally without a wicked thought in their heads.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00041","sourceRef":"oretsuba-afterstory:23_1d:full-00041","line":42,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「うん、濁ってない」","english":"“Yeah. Not a speck of grime.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00042","sourceRef":"oretsuba-afterstory:23_1d:full-00042","line":43,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「うん、擦れてない」","english":"“Yeah. Not the least bit jaded.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00043","sourceRef":"oretsuba-afterstory:23_1d:full-00043","line":44,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「清らかだなぁー」","english":"“So wholesome...”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00044","sourceRef":"oretsuba-afterstory:23_1d:full-00044","line":45,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「爽やかだなぁー」","english":"“So refreshing...”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00045","sourceRef":"oretsuba-afterstory:23_1d:full-00045","line":46,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「目ぇキラッキラしてるもんなー」","english":"“Look how their eyes sparkle.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00046","sourceRef":"oretsuba-afterstory:23_1d:full-00046","line":47,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あれはまだ悲しいとき素直に涙が出てくる目だなあ」","english":"“Those are the eyes of girls who can still cry honest tears when they’re sad.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00047","sourceRef":"oretsuba-afterstory:23_1d:full-00047","line":48,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「まだ誰に対しても打算なく笑える目だなー」","english":"“The eyes of girls who can still smile at anyone without an ulterior motive.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00048","sourceRef":"oretsuba-afterstory:23_1d:full-00048","line":49,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「まだ妥協や挫折を知らない目だなあ」","english":"“The eyes of girls who still know nothing of compromise or defeat.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00049","sourceRef":"oretsuba-afterstory:23_1d:full-00049","line":50,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「サンタさんとか信じててほしいなー」","english":"“I hope they still believe in Santa.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00050","sourceRef":"oretsuba-afterstory:23_1d:full-00050","line":51,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「将来の夢はお嫁さんとか言ってほしいなあ」","english":"“I hope they say their dream is to be a bride someday.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00051","sourceRef":"oretsuba-afterstory:23_1d:full-00051","line":52,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「私にもあんな時代があったのかなー」","english":"“Was I ever like that?”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00052","sourceRef":"oretsuba-afterstory:23_1d:full-00052","line":53,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「うちらはいつから子供じゃなくなったのかなあ」","english":"“When did we stop being children?”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00053","sourceRef":"oretsuba-afterstory:23_1d:full-00053","line":54,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「大人とは、裏切られた青年の姿である──太宰治」","english":"“An adult is a youth who has been betrayed—Osamu Dazai.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00054","sourceRef":"oretsuba-afterstory:23_1d:full-00054","line":55,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「ふー、若いっていいね」","english":"“Ah, it’s good to be young.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00055","sourceRef":"oretsuba-afterstory:23_1d:full-00055","line":56,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「筋肉痛とか、ならないんだろうねー」","english":"“I bet their muscles never get sore.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00056","sourceRef":"oretsuba-afterstory:23_1d:full-00056","line":57,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「後ろ向いたとき、腰イタッとかならないんだろうね」","english":"“I bet they never turn around and go, ‘Ow, my back.’”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00057","sourceRef":"oretsuba-afterstory:23_1d:full-00057","line":58,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「はー……ランドセル放りだして日が暮れるまで遊んでたころが懐かしいなー」","english":"“Sigh... I miss the days when I’d toss down my schoolbag and play until sunset.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00058","sourceRef":"oretsuba-afterstory:23_1d:full-00058","line":59,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「ばーちゃん、よくママに内緒でお小遣いくれたっけなあ」","english":"“Grandma used to slip me spending money behind Mom’s back.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00059","sourceRef":"oretsuba-afterstory:23_1d:full-00059","line":60,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「あーそだー、手に握った十円玉の匂いって一瞬あの頃にトリップできるよねー」","english":"“Oh, yeah! One whiff of the ten-yen coin in your hand takes you straight back there.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00060","sourceRef":"oretsuba-afterstory:23_1d:full-00060","line":61,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あの頃かあ……粉ジュースとか１０円カステラとか、不思議と美味しかったなあ」","english":"“Those days... Powdered juice and ten-yen sponge cakes tasted so good somehow.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00061","sourceRef":"oretsuba-afterstory:23_1d:full-00061","line":62,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「ズックに砂盛ったりして遊んだよねー」","english":"“We used to fill our sneakers with sand for fun.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00062","sourceRef":"oretsuba-afterstory:23_1d:full-00062","line":63,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「習字セットって、いま持ったら大して重くないんだろうなあ」","english":"“I bet my calligraphy set wouldn’t feel half as heavy now.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00063","sourceRef":"oretsuba-afterstory:23_1d:full-00063","line":64,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「給食が揚げパンの日はテンション上がるんだよねー」","english":"“Fried-bread day at school lunch was the best.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00064","sourceRef":"oretsuba-afterstory:23_1d:full-00064","line":65,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「私、鶏肉のクリーム煮みたいの好きだった」","english":"“I liked that creamy chicken stew.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00065","sourceRef":"oretsuba-afterstory:23_1d:full-00065","line":66,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「子供『ちやにくになるもの』大好きだもんねー」","english":"“Kids love anything that makes them big and strong.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00066","sourceRef":"oretsuba-afterstory:23_1d:full-00066","line":67,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あ……そいぇば、付属ってお昼、給食だったよね」","english":"“Oh... Come to think of it, they serve lunch at the affiliated school, don’t they?”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00067","sourceRef":"oretsuba-afterstory:23_1d:full-00067","line":68,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「いいなー、あの子ら、まだソフト麺とか食べてるんだー」","english":"“Lucky. Those two still get soft noodles and everything.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00068","sourceRef":"oretsuba-afterstory:23_1d:full-00068","line":69,"speakerJa":"小鳩","speakerEn":"Kobato","japanese":"「吉川さん、体力かいふくした？」","english":"“Feeling rested, Yoshikawa?”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00069","sourceRef":"oretsuba-afterstory:23_1d:full-00069","line":70,"speakerJa":"吉川","speakerEn":"Kikkawa","japanese":"「うん、もう元気。じゃあ始めようか」","english":"“Yeah, I’m all better. Let’s start.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00070","sourceRef":"oretsuba-afterstory:23_1d:full-00070","line":71,"speakerJa":"小鳩","speakerEn":"Kobato","japanese":"「コート、こんど私がこっち側ね」","english":"“I’ll take this side of the court this time.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00071","sourceRef":"oretsuba-afterstory:23_1d:full-00071","line":72,"speakerJa":"吉川","speakerEn":"Kikkawa","japanese":"「じゃあ私、あっち行……きゃああっ」","english":"“Then I’ll go over th—aaah!”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00072","sourceRef":"oretsuba-afterstory:23_1d:full-00072","line":73,"speakerJa":"小鳩","speakerEn":"Kobato","japanese":"「だっ、だいじょぶ！？」","english":"“A-are you okay?!”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00073","sourceRef":"oretsuba-afterstory:23_1d:full-00073","line":74,"speakerJa":"吉川","speakerEn":"Kikkawa","japanese":"「えへへ、だいじょぶー」","english":"“Hee-hee, I’m fine.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00074","sourceRef":"oretsuba-afterstory:23_1d:full-00074","line":75,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00075","sourceRef":"oretsuba-afterstory:23_1d:full-00075","line":76,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00076","sourceRef":"oretsuba-afterstory:23_1d:full-00076","line":77,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「……転んでる」","english":"“...She fell over.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00077","sourceRef":"oretsuba-afterstory:23_1d:full-00077","line":78,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「転んでるねー」","english":"“She sure did.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00078","sourceRef":"oretsuba-afterstory:23_1d:full-00078","line":79,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「ドジっ子だ」","english":"“What a klutz.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00079","sourceRef":"oretsuba-afterstory:23_1d:full-00079","line":80,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「子供はおおむねドジっ子だよねー」","english":"“Most children are klutzes.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00080","sourceRef":"oretsuba-afterstory:23_1d:full-00080","line":81,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「てか、子供のころって、なんであんな頻繁に転んでたんだろ」","english":"“Why did we fall over so much when we were kids, anyway?”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00081","sourceRef":"oretsuba-afterstory:23_1d:full-00081","line":82,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「若者は前を向いて歩き、老人は下を向いて歩く──オートリィ・ナルーン」","english":"“The young walk with their eyes ahead; the old walk with their eyes down—Naruun Ohtorii.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00082","sourceRef":"oretsuba-afterstory:23_1d:full-00082","line":83,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「大人ってこざかしいね」","english":"“Adults are so smug.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00083","sourceRef":"oretsuba-afterstory:23_1d:full-00083","line":84,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「そんな大人にはなりたくないねー」","english":"“I never want to be that kind of adult.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00084","sourceRef":"oretsuba-afterstory:23_1d:full-00084","line":85,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「前を向いて歩ける大人になりたいよね」","english":"“I want to be an adult who can keep looking ahead.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00085","sourceRef":"oretsuba-afterstory:23_1d:full-00085","line":86,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「痛みを避ける賢さより、痛みに耐える強さを持ちたいよねー」","english":"“I’d rather have the strength to endure pain than the wisdom to avoid it.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00086","sourceRef":"oretsuba-afterstory:23_1d:full-00086","line":87,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「てゆか、バメンで大人と子供を使いわけちゃう、うちらの世代がいちばんしゃらくさいよね」","english":"“Actually, our generation is the smuggest of all. We call ourselves adults or children depending on what suits us.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00087","sourceRef":"oretsuba-afterstory:23_1d:full-00087","line":88,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「ハイ、ていうオチを付けたところでー」","english":"“Okay, now that we’ve supplied the punchline—”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00088","sourceRef":"oretsuba-afterstory:23_1d:full-00088","line":89,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「でー？」","english":"“Then?”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00089","sourceRef":"oretsuba-afterstory:23_1d:full-00089","line":90,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「そろそろ始めますかー！」","english":"“Why don’t we get started?”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00090","sourceRef":"oretsuba-afterstory:23_1d:full-00090","line":91,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「なにを？」","english":"“On what?”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00091","sourceRef":"oretsuba-afterstory:23_1d:full-00091","line":92,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「いや、課題……」","english":"“The assignment...”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00092","sourceRef":"oretsuba-afterstory:23_1d:full-00092","line":93,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あ、そいぇば私、夏休みの宿題３１日までやらない子だった」","english":"“Oh, come to think of it, I was the kind of kid who didn’t start her summer homework until the thirty-first.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00093","sourceRef":"oretsuba-afterstory:23_1d:full-00093","line":94,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「わー、三つ子の魂百までー」","english":"“Wow. Old habits die hard.”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00094","sourceRef":"oretsuba-afterstory:23_1d:full-00094","line":95,"speakerJa":"","speakerEn":"","japanese":"「………………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00095","sourceRef":"oretsuba-afterstory:23_1d:full-00095","line":96,"speakerJa":"","speakerEn":"","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1d:full-00096","sourceRef":"oretsuba-afterstory:23_1d:full-00096","line":97,"speakerJa":"","speakerEn":"","japanese":"「……」","english":"“...”"}]}

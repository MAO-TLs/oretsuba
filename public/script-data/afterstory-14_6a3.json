{"route":"afterstory","routeLabel":"AfterStory","scriptId":"afterstory-14_6a3","lineCount":4,"lines":[{"ref":"oretsuba:afterstory:afterstory-14_6a3:full-00000","sourceRef":"oretsuba-afterstory:14_6a3:full-00000","line":1,"speakerJa":"鷹志","speakerEn":"Takashi","japanese":"「まあ渋々でも選ばなくちゃいけないならこれだな」","english":"“If I have to choose one, however reluctantly, I guess this one.”"},{"ref":"oretsuba:afterstory:afterstory-14_6a3:full-00001","sourceRef":"oretsuba-afterstory:14_6a3:full-00001","line":2,"speakerJa":"蔵人","speakerEn":"Kuroudo","japanese":"「ふうん、青姦」","english":"“Huh. Outdoor sex.”"},{"ref":"oretsuba:afterstory:afterstory-14_6a3:full-00002","sourceRef":"oretsuba-afterstory:14_6a3:full-00002","line":3,"speakerJa":"蔵人","speakerEn":"Kuroudo","japanese":"「げらげらげら、おまえヘンタイだな」","english":"“Gahahaha! You're a fucking pervert.”"},{"ref":"oretsuba:afterstory:afterstory-14_6a3:full-00003","sourceRef":"oretsuba-afterstory:14_6a3:full-00003","line":4,"speakerJa":"鷹志","speakerEn":"Takashi","japanese":"「普段の行動見ても、ヘンタイなのはあんただよ」","english":"“Judging by how you normally act, you're the pervert.”"}]}

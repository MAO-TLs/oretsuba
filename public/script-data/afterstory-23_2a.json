{"route":"afterstory","routeLabel":"AfterStory","scriptId":"afterstory-23_2a","lineCount":71,"lines":[{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00000","sourceRef":"oretsuba-afterstory:23_2a:full-00000","line":1,"speakerJa":"女性アナウンサー","speakerEn":"Female Announcer","japanese":"『皆さんおはようございます！　朝６時になりました！』","english":"“Good morning, everyone! It is now six a.m.!”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00001","sourceRef":"oretsuba-afterstory:23_2a:full-00001","line":2,"speakerJa":"女性アナウンサー","speakerEn":"Female Announcer","japanese":"『今日は陽射しもあたたかく、１２月なかばにしては過ごしやすい一日になりそうです。さて今朝のニュースですが……』","english":"“Today’s warm sunshine should make for a pleasant day by mid-December standards. And now for this morning’s news...”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00002","sourceRef":"oretsuba-afterstory:23_2a:full-00002","line":3,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「あ」","english":"“Oh.”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00003","sourceRef":"oretsuba-afterstory:23_2a:full-00003","line":4,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あっ」","english":"“Oh!”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00004","sourceRef":"oretsuba-afterstory:23_2a:full-00004","line":5,"speakerJa":"吉川","speakerEn":"Kikkawa","japanese":"「ああ」","english":"“Ah.”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00005","sourceRef":"oretsuba-afterstory:23_2a:full-00005","line":6,"speakerJa":"小鳩","speakerEn":"Kobato","japanese":"「あー……」","english":"“Ah...”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00006","sourceRef":"oretsuba-afterstory:23_2a:full-00006","line":7,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「えっとー……」","english":"“Um...”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00007","sourceRef":"oretsuba-afterstory:23_2a:full-00007","line":8,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「……お、おはよ」","english":"“...G-good morning.”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00008","sourceRef":"oretsuba-afterstory:23_2a:full-00008","line":9,"speakerJa":"吉川","speakerEn":"Kikkawa","japanese":"「おは、おはようございますっ」","english":"“G-good morning!”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00009","sourceRef":"oretsuba-afterstory:23_2a:full-00009","line":10,"speakerJa":"小鳩","speakerEn":"Kobato","japanese":"「ございますっ」","english":"“Morning!”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00010","sourceRef":"oretsuba-afterstory:23_2a:full-00010","line":11,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「わ、あれー奇遇ー。どーしたのみんな、こんな朝早くー」","english":"“W-wow, what a coincidence. What brings everyone out so early?”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00011","sourceRef":"oretsuba-afterstory:23_2a:full-00011","line":12,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「う、うん……まあ、ちょっと早起きしちゃったから、なんとなくね」","english":"“Y-yeah... I just woke up early and thought I’d come by. No real reason.”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00012","sourceRef":"oretsuba-afterstory:23_2a:full-00012","line":13,"speakerJa":"吉川","speakerEn":"Kikkawa","japanese":"「わ、私も実は、今日たまたま早く目が覚めちゃって……」","english":"“I-I happened to wake up early today too...”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00013","sourceRef":"oretsuba-afterstory:23_2a:full-00013","line":14,"speakerJa":"小鳩","speakerEn":"Kobato","japanese":"「わた、私も、じゃあそれで」","english":"“M-me too. I’ll go with that.”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00014","sourceRef":"oretsuba-afterstory:23_2a:full-00014","line":15,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「あーそうなんだー。あるよねー、あるある」","english":"“Oh, really? Yeah, that happens. Happens all the time.”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00015","sourceRef":"oretsuba-afterstory:23_2a:full-00015","line":16,"speakerJa":"吉川","speakerEn":"Kikkawa","japanese":"「ありますあります」","english":"“It does! It really does!”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00016","sourceRef":"oretsuba-afterstory:23_2a:full-00016","line":17,"speakerJa":"小鳩","speakerEn":"Kobato","japanese":"「あるでござる」","english":"“It doth happen.”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00017","sourceRef":"oretsuba-afterstory:23_2a:full-00017","line":18,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00018","sourceRef":"oretsuba-afterstory:23_2a:full-00018","line":19,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00019","sourceRef":"oretsuba-afterstory:23_2a:full-00019","line":20,"speakerJa":"吉川","speakerEn":"Kikkawa","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00020","sourceRef":"oretsuba-afterstory:23_2a:full-00020","line":21,"speakerJa":"小鳩","speakerEn":"Kobato","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00021","sourceRef":"oretsuba-afterstory:23_2a:full-00021","line":22,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「はー、そっかそっかー、なるほどねー。ふーん。じゃあ、そういうことで、お先にー」","english":"“Oh, I see. That explains it. Huh. Well, in that case, I’ll be going on ahead.”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00022","sourceRef":"oretsuba-afterstory:23_2a:full-00022","line":23,"speakerJa":"吉川","speakerEn":"Kikkawa","japanese":"「あっ！」","english":"“Wait!”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00023","sourceRef":"oretsuba-afterstory:23_2a:full-00023","line":24,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「鳴ちゃんストーップ！」","english":"“Naru, stop!”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00024","sourceRef":"oretsuba-afterstory:23_2a:full-00024","line":25,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「え？　え、なに？」","english":"“What? What is it?”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00025","sourceRef":"oretsuba-afterstory:23_2a:full-00025","line":26,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「待って、私が先に行く。理由はとくにないけど」","english":"“Wait. I’m going in first. There’s no particular reason.”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00026","sourceRef":"oretsuba-afterstory:23_2a:full-00026","line":27,"speakerJa":"小鳩","speakerEn":"Kobato","japanese":"「あ、いえ、私が一番で入ります。りゆうはとくにありません」","english":"“No, I’ll be the first through. I have no particular reason either.”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00027","sourceRef":"oretsuba-afterstory:23_2a:full-00027","line":28,"speakerJa":"吉川","speakerEn":"Kikkawa","japanese":"「あのう、私も理由はないんですが……」","english":"“Um, I don’t have a reason, but I’d like to go first too...”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00028","sourceRef":"oretsuba-afterstory:23_2a:full-00028","line":29,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「え、ええ？　なに？　ちょっと、やだ、みんなどうしちゃったの？　まさか朝イチ校門のおまじないとか、真に受けちゃってるひといないよね？」","english":"“Wh-what? What’s gotten into all of you? Surely nobody here took that first-through-the-gate charm seriously?”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00029","sourceRef":"oretsuba-afterstory:23_2a:full-00029","line":30,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「そう言ってる鳴ちゃんの目が、いちばんギラついてるけどね」","english":"“Says the girl with the wildest look in her eyes.”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00030","sourceRef":"oretsuba-afterstory:23_2a:full-00030","line":31,"speakerJa":"小鳩","speakerEn":"Kobato","japanese":"「あの目はほんきです」","english":"“She is serious.”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00031","sourceRef":"oretsuba-afterstory:23_2a:full-00031","line":32,"speakerJa":"吉川","speakerEn":"Kikkawa","japanese":"「私、負けません」","english":"“I won’t lose.”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00032","sourceRef":"oretsuba-afterstory:23_2a:full-00032","line":33,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00033","sourceRef":"oretsuba-afterstory:23_2a:full-00033","line":34,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00034","sourceRef":"oretsuba-afterstory:23_2a:full-00034","line":35,"speakerJa":"吉川","speakerEn":"Kikkawa","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00035","sourceRef":"oretsuba-afterstory:23_2a:full-00035","line":36,"speakerJa":"小鳩","speakerEn":"Kobato","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00036","sourceRef":"oretsuba-afterstory:23_2a:full-00036","line":37,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「こほん、えー」","english":"“Ahem. Now then.”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00037","sourceRef":"oretsuba-afterstory:23_2a:full-00037","line":38,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「どうでしょう、皆さん。わたくしに提案があるのですが」","english":"“Ladies, I have a proposal.”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00038","sourceRef":"oretsuba-afterstory:23_2a:full-00038","line":39,"speakerJa":"小鳩","speakerEn":"Kobato","japanese":"「てーあん？」","english":"“A proposal?”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00039","sourceRef":"oretsuba-afterstory:23_2a:full-00039","line":40,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「協定と言ってもいいでしょう」","english":"“You might even call it a pact.”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00040","sourceRef":"oretsuba-afterstory:23_2a:full-00040","line":41,"speakerJa":"吉川","speakerEn":"Kikkawa","japanese":"「はあ……」","english":"“Uh-huh...”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00041","sourceRef":"oretsuba-afterstory:23_2a:full-00041","line":42,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「ハイ、気を付けー」","english":"“Okay, atten-tion!”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00042","sourceRef":"oretsuba-afterstory:23_2a:full-00042","line":43,"speakerJa":"小鳩","speakerEn":"Kobato","japanese":"「ぴしっ」","english":"“Snap!”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00043","sourceRef":"oretsuba-afterstory:23_2a:full-00043","line":44,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「ハイ、脚は揃えてくださーい？　フライングは死刑ですよー」","english":"“Feet together, please. Jump the gun and you’re dead.”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00044","sourceRef":"oretsuba-afterstory:23_2a:full-00044","line":45,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あーッ！　吉川ちゃん、こすい！　爪先３ミリ出てる！」","english":"“Hey! Yoshikawa, you cheat! Your toe is three millimeters over the line!”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00045","sourceRef":"oretsuba-afterstory:23_2a:full-00045","line":46,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「なにー、許さんぞー！」","english":"“What? Unforgivable!”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00046","sourceRef":"oretsuba-afterstory:23_2a:full-00046","line":47,"speakerJa":"吉川","speakerEn":"Kikkawa","japanese":"「え、えっ、出てました？　でも３ミリって、ほんのちょっと──」","english":"“Huh? It was? But three millimeters is barely—”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00047","sourceRef":"oretsuba-afterstory:23_2a:full-00047","line":48,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「デュクシ！　デュクシ、デュクシ！」","english":"“Kapow! Kapow, kapow!”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00048","sourceRef":"oretsuba-afterstory:23_2a:full-00048","line":49,"speakerJa":"吉川","speakerEn":"Kikkawa","japanese":"「す、すみ……すみません、もうしません……」","english":"“I-I’m sorry... I won’t do it again...”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00049","sourceRef":"oretsuba-afterstory:23_2a:full-00049","line":50,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「ちょ、そこのふたりー！　ふざけてないで、ちゃんと並べし！」","english":"“You two! Quit screwing around and get in line!”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00050","sourceRef":"oretsuba-afterstory:23_2a:full-00050","line":51,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「あー、そーだった。もたもたしてたら他の子が登校してきちゃう。ハイ気を付けー」","english":"“Oh, right. If we waste any more time, other students will start arriving. Atten-tion!”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00051","sourceRef":"oretsuba-afterstory:23_2a:full-00051","line":52,"speakerJa":"小鳩","speakerEn":"Kobato","japanese":"「ぴしっ」","english":"“Snap!”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00052","sourceRef":"oretsuba-afterstory:23_2a:full-00052","line":53,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「行くよー、分かってる？　全員同時だからね？」","english":"“Ready? We all go at the exact same time.”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00053","sourceRef":"oretsuba-afterstory:23_2a:full-00053","line":54,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「スタートは『せーのー、せっ』だよ。『せー、のっ』じゃないからね。いい？　間違えたら許さないよ」","english":"“We start on ‘ready, set, go,’ not ‘ready, go.’ Got it? I won’t forgive anyone who messes up.”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00054","sourceRef":"oretsuba-afterstory:23_2a:full-00054","line":55,"speakerJa":"吉川","speakerEn":"Kikkawa","japanese":"「羽田さん、亜衣ちゃん先輩って、おまじない信じてないわりに必死だよね」","english":"“Haneda, Ai sure is desperate for someone who doesn’t believe in the charm.”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00055","sourceRef":"oretsuba-afterstory:23_2a:full-00055","line":56,"speakerJa":"小鳩","speakerEn":"Kobato","japanese":"「おぼれる者はワラにもすがります」","english":"“A drowning woman will clutch at a straw.”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00056","sourceRef":"oretsuba-afterstory:23_2a:full-00056","line":57,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「ハイ私語は慎んでー。みんな、もう願い事は考えてあるー？」","english":"“No talking in line! Has everyone decided on her wish?”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00057","sourceRef":"oretsuba-afterstory:23_2a:full-00057","line":58,"speakerJa":"小鳩","speakerEn":"Kobato","japanese":"「ピーマンぼくめつ、ピーマンぼくめつ……」","english":"“No more green peppers, no more green peppers...”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00058","sourceRef":"oretsuba-afterstory:23_2a:full-00058","line":59,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「口座に五万、口座に五万……」","english":"“Fifty thousand in my account, fifty thousand in my account...”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00059","sourceRef":"oretsuba-afterstory:23_2a:full-00059","line":60,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「ハイじゃーいいですかー、行きますよー」","english":"“Okay, is everybody ready? Here we go!”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00060","sourceRef":"oretsuba-afterstory:23_2a:full-00060","line":61,"speakerJa":"小鳩","speakerEn":"Kobato","japanese":"「せいきのいっしゅんです」","english":"“The moment of truth.”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00061","sourceRef":"oretsuba-afterstory:23_2a:full-00061","line":62,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「せぇー、のぉー……」","english":"“Ready... set...”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00062","sourceRef":"oretsuba-afterstory:23_2a:full-00062","line":63,"speakerJa":"全員","speakerEn":"Everyone","japanese":"「せっ！」","english":"“Go!”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00063","sourceRef":"oretsuba-afterstory:23_2a:full-00063","line":64,"speakerJa":"小鳩","speakerEn":"Kobato","japanese":"「ピーマン撲滅！」","english":"“Death to green peppers!”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00064","sourceRef":"oretsuba-afterstory:23_2a:full-00064","line":65,"speakerJa":"吉川","speakerEn":"Kikkawa","japanese":"「お休みください！」","english":"“Please cancel my lesson!”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00065","sourceRef":"oretsuba-afterstory:23_2a:full-00065","line":66,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「学業安泰！」","english":"“Academic success!”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00066","sourceRef":"oretsuba-afterstory:23_2a:full-00066","line":67,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「恋愛成就ーッ！」","english":"“Let my love work out!”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00067","sourceRef":"oretsuba-afterstory:23_2a:full-00067","line":68,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「…………え？」","english":"“...What?”"},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00068","sourceRef":"oretsuba-afterstory:23_2a:full-00068","line":69,"speakerJa":"","speakerEn":"","japanese":"こうして今日もアオジョの一日が始まる。","english":"And so another day begins at Azure Sky Girls’ Academy."},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00069","sourceRef":"oretsuba-afterstory:23_2a:full-00069","line":70,"speakerJa":"","speakerEn":"","japanese":"手付かずの課題に対していかなる裁量が下されるか、それは菅原ないしアルキメデスのみぞ知るところだ。","english":"What judgment will be handed down upon the untouched assignment is known only to Sugawara—or perhaps Archimedes."},{"ref":"oretsuba:afterstory:afterstory-23_2a:full-00070","sourceRef":"oretsuba-afterstory:23_2a:full-00070","line":71,"speakerJa":"","speakerEn":"","japanese":"ご静聴ありがとうございました。","english":"Thank you for your kind attention."}]}

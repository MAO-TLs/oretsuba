{"route":"afterstory","routeLabel":"AfterStory","scriptId":"afterstory-23_1b","lineCount":163,"lines":[{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00000","sourceRef":"oretsuba-afterstory:23_1b:full-00000","line":1,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「ふー……」","english":"“Whew...”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00001","sourceRef":"oretsuba-afterstory:23_1b:full-00001","line":2,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「はー……」","english":"“Sigh...”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00002","sourceRef":"oretsuba-afterstory:23_1b:full-00002","line":3,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「鳴ちゃーん……」","english":"“Naruuu...”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00003","sourceRef":"oretsuba-afterstory:23_1b:full-00003","line":4,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「えー？　なにー、亜衣ちゃん……」","english":"“Whaaat, Aiii...?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00004","sourceRef":"oretsuba-afterstory:23_1b:full-00004","line":5,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あの、アレ……数学のアレ、どーなってるー？」","english":"“So, that thing... How’s the math thing going?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00005","sourceRef":"oretsuba-afterstory:23_1b:full-00005","line":6,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「あー、個別課題……やー、どーもなってないけどー」","english":"“Oh, the individual assignment... It’s not going anywhere.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00006","sourceRef":"oretsuba-afterstory:23_1b:full-00006","line":7,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「うそ、やばいじゃん。提出期限あと三日しかないよ」","english":"“No way. That’s bad. Only three days till the deadline.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00007","sourceRef":"oretsuba-afterstory:23_1b:full-00007","line":8,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「えー、亜衣ちゃん進んでんのー？」","english":"“Wait, you’re making progress?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00008","sourceRef":"oretsuba-afterstory:23_1b:full-00008","line":9,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「まー、気持ち的には３０ページぐらい」","english":"“Emotionally, I’d say about thirty pages.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00009","sourceRef":"oretsuba-afterstory:23_1b:full-00009","line":10,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「実質的にはー？」","english":"“In reality?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00010","sourceRef":"oretsuba-afterstory:23_1b:full-00010","line":11,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「三行ぐらい？」","english":"“Maybe three lines?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00011","sourceRef":"oretsuba-afterstory:23_1b:full-00011","line":12,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「だいぶイメージ先行型だなー」","english":"“Your imagination’s doing all the work, huh.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00012","sourceRef":"oretsuba-afterstory:23_1b:full-00012","line":13,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「ふぅ……」","english":"“Whew...”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00013","sourceRef":"oretsuba-afterstory:23_1b:full-00013","line":14,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「はぁ……」","english":"“Sigh...”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00014","sourceRef":"oretsuba-afterstory:23_1b:full-00014","line":15,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「鳴ちゃーん」","english":"“Naruuu.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00015","sourceRef":"oretsuba-afterstory:23_1b:full-00015","line":16,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「んー、なにー」","english":"“Mmm? What?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00016","sourceRef":"oretsuba-afterstory:23_1b:full-00016","line":17,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「今日はもう、マジで始めないとヤバいよね」","english":"“We seriously have to start today, don’t we?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00017","sourceRef":"oretsuba-afterstory:23_1b:full-00017","line":18,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「だねー。いよいよ本気出さないとねー」","english":"“Yeah. It’s finally time to get serious.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00018","sourceRef":"oretsuba-afterstory:23_1b:full-00018","line":19,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「じゃあ……始める……？」","english":"“So... start?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00019","sourceRef":"oretsuba-afterstory:23_1b:full-00019","line":20,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「そーねー、もうちょっと溜めたら始めるー」","english":"“Yeah. Once I charge up a little more.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00020","sourceRef":"oretsuba-afterstory:23_1b:full-00020","line":21,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「ま、充電は大事だよね」","english":"“Charging is important.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00021","sourceRef":"oretsuba-afterstory:23_1b:full-00021","line":22,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「私らもう若くないから、燃費悪いもんねー」","english":"“We’re not young anymore. Terrible fuel economy.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00022","sourceRef":"oretsuba-afterstory:23_1b:full-00022","line":23,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00023","sourceRef":"oretsuba-afterstory:23_1b:full-00023","line":24,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00024","sourceRef":"oretsuba-afterstory:23_1b:full-00024","line":25,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「鳴ちゃーん？　口閉じなー」","english":"“Naru? Close your mouth.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00025","sourceRef":"oretsuba-afterstory:23_1b:full-00025","line":26,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「えー？　んー」","english":"“What? Mmm.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00026","sourceRef":"oretsuba-afterstory:23_1b:full-00026","line":27,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00027","sourceRef":"oretsuba-afterstory:23_1b:full-00027","line":28,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00028","sourceRef":"oretsuba-afterstory:23_1b:full-00028","line":29,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「鳴ちゃーん」","english":"“Naruuu.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00029","sourceRef":"oretsuba-afterstory:23_1b:full-00029","line":30,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「閉じてるよー」","english":"“It’s closed.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00030","sourceRef":"oretsuba-afterstory:23_1b:full-00030","line":31,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「ひまー。なんか話してー」","english":"“I’m bored. Say something.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00031","sourceRef":"oretsuba-afterstory:23_1b:full-00031","line":32,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「えー、どんな話ー？」","english":"“What kind of something?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00032","sourceRef":"oretsuba-afterstory:23_1b:full-00032","line":33,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「なんでもいい、面白いの」","english":"“Anything. Something funny.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00033","sourceRef":"oretsuba-afterstory:23_1b:full-00033","line":34,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「面白いのー？　面白いの無理ー」","english":"“Something funny? Can’t do funny.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00034","sourceRef":"oretsuba-afterstory:23_1b:full-00034","line":35,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「じゃー、つまんない話でもいいよー」","english":"“Then a boring story is fine.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00035","sourceRef":"oretsuba-afterstory:23_1b:full-00035","line":36,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「『面白そうだけどつまんない話』ならできるかも」","english":"“I might have a story that sounds interesting but isn’t.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00036","sourceRef":"oretsuba-afterstory:23_1b:full-00036","line":37,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「なにそれ。聞かせろし」","english":"“What does that mean? Tell me.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00037","sourceRef":"oretsuba-afterstory:23_1b:full-00037","line":38,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「あのねー、一ヵ月ぐらい前かなー。ギバラのコインパーキングで、左右田さんたちにばったり会ってー」","english":"“Okay, so about a month ago? I ran into Souda and his friends at a parking lot in Gibara.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00038","sourceRef":"oretsuba-afterstory:23_1b:full-00038","line":39,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あー、フレイムバーズの人ら？」","english":"“Oh, the Flame Birds guys?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00039","sourceRef":"oretsuba-afterstory:23_1b:full-00039","line":40,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「そー。そんで、そん中の一人が、あのー、なんか防塵マスクってゆーの？　映画の毒ガス部隊みたいな、こう、ごっついので顔覆っててー。ずっとシュコーシュコーゆってんの」","english":"“Right. And one of them was wearing, um, one of those dust masks? This huge thing over his face, like a poison-gas soldier in a movie. He kept going khoo-khaa, khoo-khaa.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00040","sourceRef":"oretsuba-afterstory:23_1b:full-00040","line":41,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「うそ、なにそれ。なんでなんで？」","english":"“No way. What was it? Why?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00041","sourceRef":"oretsuba-afterstory:23_1b:full-00041","line":42,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「気になるでしょー？　で見てたらー、向こうからすっごい、鹿鳴館から来ましたみたいな格好のご婦人がしずしず歩いてきてー」","english":"“You wanna know, right? So while I was watching, this lady came walking all gracefully toward them, dressed like she’d stepped out of the Rokumeikan.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00042","sourceRef":"oretsuba-afterstory:23_1b:full-00042","line":43,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「おお、なんだそれ。どんな展開だ」","english":"“Ooh, what’s this? Where’s the story going?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00043","sourceRef":"oretsuba-afterstory:23_1b:full-00043","line":44,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「でー、こっちはこっちで、左右田さんたちみんな不敵な顔してんの。こいつはただのゲームだーとか、俺らも所詮ガキだからなーとか。ザワザワザワーって」","english":"“And Souda and the guys are all looking fearless. Saying stuff like, ‘It’s only a game,’ and ‘We’re just kids in the end.’ The tension’s rising...”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00044","sourceRef":"oretsuba-afterstory:23_1b:full-00044","line":45,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「おおっ！　なになに、なんか起きんの！？」","english":"“Ooh! What happens? Does something happen?!”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00045","sourceRef":"oretsuba-afterstory:23_1b:full-00045","line":46,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「そしたらもー、まさにそのときですよ、ブゥーンって横からパトカー来て」","english":"“And then, right at that exact moment, a police car comes humming in from the side.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00046","sourceRef":"oretsuba-afterstory:23_1b:full-00046","line":47,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「うっはー、一触即発！」","english":"“Whoa! A powder keg!”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00047","sourceRef":"oretsuba-afterstory:23_1b:full-00047","line":48,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「で、そのままブゥーンって通りすぎて」","english":"“And it keeps humming right past them.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00048","sourceRef":"oretsuba-afterstory:23_1b:full-00048","line":49,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「え……ああ、そこは一波乱あるわけじゃないんだ」","english":"“Oh... So nothing happens there.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00049","sourceRef":"oretsuba-afterstory:23_1b:full-00049","line":50,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「うん、ない。そんで、左右田さんたちみんな、ぞろぞろーってゲームセンター行って」","english":"“Nope. Then Souda and his friends all file into the arcade.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00050","sourceRef":"oretsuba-afterstory:23_1b:full-00050","line":51,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あ、はあ、それで？」","english":"“Uh-huh. And?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00051","sourceRef":"oretsuba-afterstory:23_1b:full-00051","line":52,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「それで、おしまい。私そこで別れたけど、みんなフツーにゲームやって帰ったんじゃない？」","english":"“And that’s the end. I left them there, but they probably played games and went home like normal.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00052","sourceRef":"oretsuba-afterstory:23_1b:full-00052","line":53,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「……え、『こいつはただのゲームだ』って、マジでただのゲームだったの？」","english":"“Wait. When they said, ‘It’s only a game,’ they literally meant a game?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00053","sourceRef":"oretsuba-afterstory:23_1b:full-00053","line":54,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「そーそーそ」","english":"“Right, right.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00054","sourceRef":"oretsuba-afterstory:23_1b:full-00054","line":55,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「防塵マスクはなんの用意よ」","english":"“What was the dust mask for?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00055","sourceRef":"oretsuba-afterstory:23_1b:full-00055","line":56,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「ファッションだって。素顔だと目ぇパッチリしてて迫力ないからって」","english":"“Fashion. His eyes look too big and pretty without it, so he isn’t intimidating.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00056","sourceRef":"oretsuba-afterstory:23_1b:full-00056","line":57,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「鹿鳴館のマダムは？」","english":"“And the Rokumeikan lady?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00057","sourceRef":"oretsuba-afterstory:23_1b:full-00057","line":58,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「知らない。通りすがりのアゲ嬢じゃない？」","english":"“No idea. Some hostess type passing by?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00058","sourceRef":"oretsuba-afterstory:23_1b:full-00058","line":59,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「え、無関係なの？　じゃ、そのくだり要らなくね？」","english":"“She had nothing to do with it? Then wasn’t that part unnecessary?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00059","sourceRef":"oretsuba-afterstory:23_1b:full-00059","line":60,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「だーって、話してて、ふと思いだしちゃったんだもん。物語じゃないからさー、生の会話には無駄があって然るべきだと思うんだー」","english":"“But I remembered her while I was talking. This isn’t a story. Real conversations are supposed to have useless parts.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00060","sourceRef":"oretsuba-afterstory:23_1b:full-00060","line":61,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あー……ま、そー言われると、うちのベシャリも大概そんなんだけどー」","english":"“Ah... Well, when you put it that way, most of my chatter’s like that too.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00061","sourceRef":"oretsuba-afterstory:23_1b:full-00061","line":62,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「そーだ。こないだキューちゃんらが話してるの聞いてたら、全編そんなノリだったー」","english":"“Oh, right. I listened to Kyuu and the others talking the other day, and the whole conversation was like that.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00062","sourceRef":"oretsuba-afterstory:23_1b:full-00062","line":63,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あ、キューちゃんと吉川ちゃんでしょ？　あの子らの会話、一周まわって逆にすごいよね」","english":"“Oh, Kyuu and Yoshikawa? Their conversations are so bad they go all the way around to amazing.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00063","sourceRef":"oretsuba-afterstory:23_1b:full-00063","line":64,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「逆に真似できないよねー」","english":"“You couldn’t imitate them if you tried.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00064","sourceRef":"oretsuba-afterstory:23_1b:full-00064","line":65,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「なんか和むし」","english":"“They’re kinda soothing.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00065","sourceRef":"oretsuba-afterstory:23_1b:full-00065","line":66,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「ほっこりするしー？」","english":"“Heartwarming, even?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00066","sourceRef":"oretsuba-afterstory:23_1b:full-00066","line":67,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「まじだ、いまあの子らいれば良かった」","english":"“Seriously, I wish they were here now.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00067","sourceRef":"oretsuba-afterstory:23_1b:full-00067","line":68,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「そーねー、こう、陽だまりにでも置いて延々と喋らせてねー」","english":"“Yeah. We could put them in a patch of sunlight and let them talk forever.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00068","sourceRef":"oretsuba-afterstory:23_1b:full-00068","line":69,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「いーかもソレ、気持ちよく眠れそ気ー」","english":"“That sounds nice. I could fall asleep so easily.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00069","sourceRef":"oretsuba-afterstory:23_1b:full-00069","line":70,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「だよねー……」","english":"“Right...”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00070","sourceRef":"oretsuba-afterstory:23_1b:full-00070","line":71,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「んー……」","english":"“Mmm...”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00071","sourceRef":"oretsuba-afterstory:23_1b:full-00071","line":72,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00072","sourceRef":"oretsuba-afterstory:23_1b:full-00072","line":73,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00073","sourceRef":"oretsuba-afterstory:23_1b:full-00073","line":74,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「ふぁ～……で、どーするー？」","english":"“Yaaawn... So, what do we do?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00074","sourceRef":"oretsuba-afterstory:23_1b:full-00074","line":75,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「なにがー？」","english":"“About what?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00075","sourceRef":"oretsuba-afterstory:23_1b:full-00075","line":76,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「えー、ほらー、始めるー課題？」","english":"“You know. Start the assignment?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00076","sourceRef":"oretsuba-afterstory:23_1b:full-00076","line":77,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あー……そーねー……まー、いい加減やらなきゃいけない系だよねえ」","english":"“Oh... Right... We’re reaching the point where we really have to.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00077","sourceRef":"oretsuba-afterstory:23_1b:full-00077","line":78,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「だよねー、ソレ系だよねー」","english":"“Yeah. It’s that kind of situation.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00078","sourceRef":"oretsuba-afterstory:23_1b:full-00078","line":79,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「んー……」","english":"“Mmm...”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00079","sourceRef":"oretsuba-afterstory:23_1b:full-00079","line":80,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00080","sourceRef":"oretsuba-afterstory:23_1b:full-00080","line":81,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00081","sourceRef":"oretsuba-afterstory:23_1b:full-00081","line":82,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「あ、ねー、亜衣ちゃんはー？」","english":"“Oh, hey, what about you, Ai?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00082","sourceRef":"oretsuba-afterstory:23_1b:full-00082","line":83,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「んー？」","english":"“Mmm?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00083","sourceRef":"oretsuba-afterstory:23_1b:full-00083","line":84,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「なんかないのー、話」","english":"“Don’t you have a story?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00084","sourceRef":"oretsuba-afterstory:23_1b:full-00084","line":85,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「つって、どんな話？」","english":"“What kind of story?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00085","sourceRef":"oretsuba-afterstory:23_1b:full-00085","line":86,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「なんでもいい、学校の話とかー」","english":"“Anything. Something about school.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00086","sourceRef":"oretsuba-afterstory:23_1b:full-00086","line":87,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「ああ、学校の怪談とか？」","english":"“Oh, like a school ghost story?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00087","sourceRef":"oretsuba-afterstory:23_1b:full-00087","line":88,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「え、そんな持ちネタあるの？」","english":"“Wait, you have one of those?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00088","sourceRef":"oretsuba-afterstory:23_1b:full-00088","line":89,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「や、ないけどさ。そんなん聞いたこともないし」","english":"“No. I’ve never even heard one.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00089","sourceRef":"oretsuba-afterstory:23_1b:full-00089","line":90,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「だよねー。ソレ系聞かないよね、この学校ー」","english":"“Right. You never hear that kind of thing at this school.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00090","sourceRef":"oretsuba-afterstory:23_1b:full-00090","line":91,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あ、でも、おまじないみたいのは聞いたことある」","english":"“Oh, but I’ve heard something like a good-luck charm.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00091","sourceRef":"oretsuba-afterstory:23_1b:full-00091","line":92,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「どんなー？」","english":"“What kind?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00092","sourceRef":"oretsuba-afterstory:23_1b:full-00092","line":93,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「学食の搬入車、七回見ると幸運が訪れるとか」","english":"“If you see the cafeteria delivery truck seven times, good luck comes to you.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00093","sourceRef":"oretsuba-afterstory:23_1b:full-00093","line":94,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「えー、なにそれー。七回ってなに、一生で七回？　それとも家に帰ったらカウンターリセットされるの？」","english":"“What? Seven times how? Seven times in your life? Or does the counter reset when you go home?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00094","sourceRef":"oretsuba-afterstory:23_1b:full-00094","line":95,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「知らんけど、そしたら学食のおばちゃん、毎日めっちゃツキまくりだよね」","english":"“No idea. Either way, the cafeteria ladies must be insanely lucky every day.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00095","sourceRef":"oretsuba-afterstory:23_1b:full-00095","line":96,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「条件あやふやな上に信憑性うっすいなー」","english":"“The conditions are vague, and it sounds totally fake.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00096","sourceRef":"oretsuba-afterstory:23_1b:full-00096","line":97,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あと、朝いちばん最初に校門くぐった子は、なんかイイこと起こるって」","english":"“There’s another one. Something good happens to the first girl through the school gate in the morning.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00097","sourceRef":"oretsuba-afterstory:23_1b:full-00097","line":98,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「おー？　それはソレっぽい。ジンクスっぽい」","english":"“Ooh? That one sounds right. Like a real superstition.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00098","sourceRef":"oretsuba-afterstory:23_1b:full-00098","line":99,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「だしょー？　感じ感じ」","english":"“Right? It has the vibe.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00099","sourceRef":"oretsuba-afterstory:23_1b:full-00099","line":100,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「うん、そー、やっぱり験担ぎってそーゆー系だよー。クルマとか文明の利器が絡んでくると途端に嘘っぽいもん」","english":"“Yeah. That’s what good-luck rituals are supposed to be like. The second you involve cars or other modern technology, it starts sounding fake.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00100","sourceRef":"oretsuba-afterstory:23_1b:full-00100","line":101,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「そそそ、校門くぐるってトコがね。神社の鳥居くぐるみたいなカンジで、何気にスピリチュアル入ってるしね」","english":"“Exactly. Going through the school gate is kinda like walking through a shrine gate, right? There’s something spiritual about it.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00101","sourceRef":"oretsuba-afterstory:23_1b:full-00101","line":102,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「あ、だって鳥居ってアレよー？　一種の境界ってゆーかー。神的なゾーンと俗的なゾーンを区画する象徴って、なんかで読んだことあるー」","english":"“Oh, aren’t those gates like a boundary? I read somewhere they mark off the god zone from the everyday zone.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00102","sourceRef":"oretsuba-afterstory:23_1b:full-00102","line":103,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あれ……そいやこの学校、さかのぼってくと寺子屋だか僧院だか、そっち系の発祥じゃなかったっけ」","english":"“Wait... Wasn’t this school originally some kind of temple school or monastery if you go far enough back?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00103","sourceRef":"oretsuba-afterstory:23_1b:full-00103","line":104,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「えー！　じゃーじゃー、もしかしてソレ、神事にまつわる由緒正しいおまじないだったり！？」","english":"“What?! Then could this be a venerable charm connected to an actual divine rite?!”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00104","sourceRef":"oretsuba-afterstory:23_1b:full-00104","line":105,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「まじで！？　プロデュースド・バイ・ゴッド？」","english":"“Seriously?! Produced by God?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00105","sourceRef":"oretsuba-afterstory:23_1b:full-00105","line":106,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「それだ！　ＰＢＧだ、ＰＢＧ！」","english":"“That’s it! PBG! PBG!”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00106","sourceRef":"oretsuba-afterstory:23_1b:full-00106","line":107,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「え、Ｇは誰？　なに神？　学問の神？」","english":"“Wait, which G? What god? The god of learning?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00107","sourceRef":"oretsuba-afterstory:23_1b:full-00107","line":108,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「菅原か」","english":"“Sugawara?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00108","sourceRef":"oretsuba-afterstory:23_1b:full-00108","line":109,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「うっそ、やるじゃん菅原Ｐ。もしかソレ、ガチでご利益あんじゃない？」","english":"“No way. Nice work, Producer Sugawara. Maybe it really does bring you luck.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00109","sourceRef":"oretsuba-afterstory:23_1b:full-00109","line":110,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「え、じゃどーする校門、行く？　行こうよ！」","english":"“Then what do we do? The school gate—wanna go? Let’s go!”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00110","sourceRef":"oretsuba-afterstory:23_1b:full-00110","line":111,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「いや、いま行ったってゼロ意味じゃん。朝イチじゃなきゃ」","english":"“There’s no point going now. It has to be first thing in the morning.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00111","sourceRef":"oretsuba-afterstory:23_1b:full-00111","line":112,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「あ、そか……やーん、うっかりー」","english":"“Oh, right... Silly me.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00112","sourceRef":"oretsuba-afterstory:23_1b:full-00112","line":113,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「出た、鳴ちゃんのドジっ子アピール」","english":"“There it is. Naru’s cute-klutz routine.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00113","sourceRef":"oretsuba-afterstory:23_1b:full-00113","line":114,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「アピってねっすー」","english":"“I’m not doing a routine.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00114","sourceRef":"oretsuba-afterstory:23_1b:full-00114","line":115,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「やっぱ男にはそーゆーキャラのがウケんのかな」","english":"“Do guys really like that kind of character?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00115","sourceRef":"oretsuba-afterstory:23_1b:full-00115","line":116,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「やー、そんなん聞かれてもー」","english":"“How would I know?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00116","sourceRef":"oretsuba-afterstory:23_1b:full-00116","line":117,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「素で？　彼氏の前でもそんななん？」","english":"“That’s really you? You act like that around your boyfriend too?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00117","sourceRef":"oretsuba-afterstory:23_1b:full-00117","line":118,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「あー、まー、たぶんそんなだと思うよー？」","english":"“Uh, well, probably? I think?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00118","sourceRef":"oretsuba-afterstory:23_1b:full-00118","line":119,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「ふーん」","english":"“Huh.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00119","sourceRef":"oretsuba-afterstory:23_1b:full-00119","line":120,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00120","sourceRef":"oretsuba-afterstory:23_1b:full-00120","line":121,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00121","sourceRef":"oretsuba-afterstory:23_1b:full-00121","line":122,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「え……で、どうする？　こんど、朝イチ校門狙う？」","english":"“So... what do we do? Try to be first through the gate sometime?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00122","sourceRef":"oretsuba-afterstory:23_1b:full-00122","line":123,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「ん？　ああ……べつにいいや。そこまで興味ないし」","english":"“Hmm? Oh... Nah. I don’t care that much.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00123","sourceRef":"oretsuba-afterstory:23_1b:full-00123","line":124,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「あ……うん、だよね、おまじないとかね、そんなね」","english":"“Oh... Yeah. Superstitions and all. Whatever.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00124","sourceRef":"oretsuba-afterstory:23_1b:full-00124","line":125,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「うん」","english":"“Yeah.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00125","sourceRef":"oretsuba-afterstory:23_1b:full-00125","line":126,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「ないよね、しょせん気休めだもんね、必死になったら恥ずかしいっすよね」","english":"“Right. They’re only for peace of mind. Getting desperate about one would be embarrassing.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00126","sourceRef":"oretsuba-afterstory:23_1b:full-00126","line":127,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「やー、べつにそこまでは言わないけど」","english":"“I wouldn’t go that far.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00127","sourceRef":"oretsuba-afterstory:23_1b:full-00127","line":128,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「そう、そこまでは言わない。鳴さん、それは言いすぎだハハッ」","english":"“Exactly. I wouldn’t go that far. Naru, that was too much. Ha-ha.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00128","sourceRef":"oretsuba-afterstory:23_1b:full-00128","line":129,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00129","sourceRef":"oretsuba-afterstory:23_1b:full-00129","line":130,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00130","sourceRef":"oretsuba-afterstory:23_1b:full-00130","line":131,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あ、鳴ちゃん」","english":"“Oh, Naru.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00131","sourceRef":"oretsuba-afterstory:23_1b:full-00131","line":132,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「はい、なに？」","english":"“Yes? What?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00132","sourceRef":"oretsuba-afterstory:23_1b:full-00132","line":133,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「え、あの、鳴ちゃん最近どーなん」","english":"“Um, how’ve you been lately?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00133","sourceRef":"oretsuba-afterstory:23_1b:full-00133","line":134,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「体重？　悲惨の一途。チョーぶくぶく」","english":"“My weight? Catastrophic. Getting huge.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00134","sourceRef":"oretsuba-afterstory:23_1b:full-00134","line":135,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「や、ちがくて恋愛方面？　イイカンジなの？　とか」","english":"“No, I mean romantically. Are things going well?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00135","sourceRef":"oretsuba-afterstory:23_1b:full-00135","line":136,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「ん？　んんー、まぁそうね、ぼちぼち……？」","english":"“Hmm? Mmm... Yeah. You know. More or less...?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00136","sourceRef":"oretsuba-afterstory:23_1b:full-00136","line":137,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あー、そーなんだ」","english":"“Oh. Okay.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00137","sourceRef":"oretsuba-afterstory:23_1b:full-00137","line":138,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「そう、うん、適当に」","english":"“Yeah. You know, whatever.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00138","sourceRef":"oretsuba-afterstory:23_1b:full-00138","line":139,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「ふーん。いいんじゃない」","english":"“Huh. That’s good.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00139","sourceRef":"oretsuba-afterstory:23_1b:full-00139","line":140,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「うん……」","english":"“Yeah...”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00140","sourceRef":"oretsuba-afterstory:23_1b:full-00140","line":141,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00141","sourceRef":"oretsuba-afterstory:23_1b:full-00141","line":142,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00142","sourceRef":"oretsuba-afterstory:23_1b:full-00142","line":143,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あ」","english":"“Oh.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00143","sourceRef":"oretsuba-afterstory:23_1b:full-00143","line":144,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「はい、なに」","english":"“Yes? What?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00144","sourceRef":"oretsuba-afterstory:23_1b:full-00144","line":145,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「やばい」","english":"“This is bad.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00145","sourceRef":"oretsuba-afterstory:23_1b:full-00145","line":146,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「な、何がスか」","english":"“Wh-what is?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00146","sourceRef":"oretsuba-afterstory:23_1b:full-00146","line":147,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「……課題やんなきゃ」","english":"“...We have to do the assignment.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00147","sourceRef":"oretsuba-afterstory:23_1b:full-00147","line":148,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「ああ！　ほんとだ！」","english":"“Oh! Right!”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00148","sourceRef":"oretsuba-afterstory:23_1b:full-00148","line":149,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あ、でも」","english":"“Oh, but...”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00149","sourceRef":"oretsuba-afterstory:23_1b:full-00149","line":150,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「はい、なんすか」","english":"“Yes? What?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00150","sourceRef":"oretsuba-afterstory:23_1b:full-00150","line":151,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「やっぱ今日もう帰りたい」","english":"“I still wanna go home today.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00151","sourceRef":"oretsuba-afterstory:23_1b:full-00151","line":152,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「あーはい、まあそりゃねー？　そりゃ私だって帰りたいけれどもねー？」","english":"“Uh-huh. I mean, sure? Obviously I wanna go home too, but?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00152","sourceRef":"oretsuba-afterstory:23_1b:full-00152","line":153,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「だしょー？　帰ろ帰ろー」","english":"“Right? Let’s go, let’s go.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00153","sourceRef":"oretsuba-afterstory:23_1b:full-00153","line":154,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「いやー、でもあと三日しか残されてないからさー」","english":"“Yeah, except there are only three days left.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00154","sourceRef":"oretsuba-afterstory:23_1b:full-00154","line":155,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「分かった、じゃあどっか店入って、ハンバーガーでも食べながらやろう」","english":"“I know. Let’s go somewhere and do it while we eat hamburgers.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00155","sourceRef":"oretsuba-afterstory:23_1b:full-00155","line":156,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「いっやあ～、バガっちゃったら勉強は……するかなあ～……」","english":"“Oof. If we go get burgers, will we actually study...?”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00156","sourceRef":"oretsuba-afterstory:23_1b:full-00156","line":157,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「いいよいいよ、行ってから考えよ」","english":"“It’s fine. We’ll think about that once we get there.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00157","sourceRef":"oretsuba-afterstory:23_1b:full-00157","line":158,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「ええー、どうかなぁ、まずい予感するなぁ……たしかにポテトＬが呼んでる気はするけどさぁ……」","english":"“I don’t know. I have a bad feeling... Though I do feel a large order of fries calling my name...”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00158","sourceRef":"oretsuba-afterstory:23_1b:full-00158","line":159,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「なんか明るいとこ行きたい気分。付きあってよ」","english":"“I feel like going somewhere bright. Come with me.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00159","sourceRef":"oretsuba-afterstory:23_1b:full-00159","line":160,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「あ、はい、分かりました」","english":"“Oh. Okay.”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00160","sourceRef":"oretsuba-afterstory:23_1b:full-00160","line":161,"speakerJa":"","speakerEn":"","japanese":"「………………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00161","sourceRef":"oretsuba-afterstory:23_1b:full-00161","line":162,"speakerJa":"","speakerEn":"","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1b:full-00162","sourceRef":"oretsuba-afterstory:23_1b:full-00162","line":163,"speakerJa":"","speakerEn":"","japanese":"「……」","english":"“...”"}]}

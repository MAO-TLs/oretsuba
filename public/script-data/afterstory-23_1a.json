{"route":"afterstory","routeLabel":"AfterStory","scriptId":"afterstory-23_1a","lineCount":178,"lines":[{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00000","sourceRef":"oretsuba-afterstory:23_1a:full-00000","line":1,"speakerJa":"","speakerEn":"","japanese":"この物語は、蒼穹女学院生の平凡な日常を淡々と描くものです。過度な期待はしないでください。","english":"This story is a quiet portrayal of the ordinary lives of students at Azure Sky Girls’ Academy. Please do not expect too much."},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00001","sourceRef":"oretsuba-afterstory:23_1a:full-00001","line":2,"speakerJa":"女子Ａ","speakerEn":"Girl A","japanese":"「じゃーまた明日ー」","english":"“Okay, see you tomorrow.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00002","sourceRef":"oretsuba-afterstory:23_1a:full-00002","line":3,"speakerJa":"女子Ｂ","speakerEn":"Girl B","japanese":"「ねーねー、このあとカラオケ行きたくね？」","english":"“Hey, hey, wanna do karaoke after this?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00003","sourceRef":"oretsuba-afterstory:23_1a:full-00003","line":4,"speakerJa":"女子Ｃ","speakerEn":"Girl C","japanese":"「いーけど、あたしハラ減ったわ。なんか食ってから行くしー」","english":"“Sure, but I’m hungry. I’m eating something first.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00004","sourceRef":"oretsuba-afterstory:23_1a:full-00004","line":5,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00005","sourceRef":"oretsuba-afterstory:23_1a:full-00005","line":6,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00006","sourceRef":"oretsuba-afterstory:23_1a:full-00006","line":7,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00007","sourceRef":"oretsuba-afterstory:23_1a:full-00007","line":8,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00008","sourceRef":"oretsuba-afterstory:23_1a:full-00008","line":9,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「鳴ちゃーん……」","english":"“Naruuu...”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00009","sourceRef":"oretsuba-afterstory:23_1a:full-00009","line":10,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「えー？　なにー、亜衣ちゃん……」","english":"“Whaaat, Aiii...?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00010","sourceRef":"oretsuba-afterstory:23_1a:full-00010","line":11,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「アレ終わったー？」","english":"“Did you finish that thing?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00011","sourceRef":"oretsuba-afterstory:23_1a:full-00011","line":12,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「どれー？」","english":"“What thing?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00012","sourceRef":"oretsuba-afterstory:23_1a:full-00012","line":13,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「ほら、うちら欠席多いからってんで出されたじゃん、数学の」","english":"“You know, the math thing they gave us ’cause we’ve missed too many classes.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00013","sourceRef":"oretsuba-afterstory:23_1a:full-00013","line":14,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「あー、個別課題」","english":"“Oh, the individual assignment.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00014","sourceRef":"oretsuba-afterstory:23_1a:full-00014","line":15,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「そうソレー、どんなカンジ気ー？」","english":"“Yeah, that. How’s it going?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00015","sourceRef":"oretsuba-afterstory:23_1a:full-00015","line":16,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「アレねえ。やー、アレはまー、キホンどーもなってないよねー。亜衣ちゃんはー？」","english":"“That thing? Uh, basically nowhere. What about you?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00016","sourceRef":"oretsuba-afterstory:23_1a:full-00016","line":17,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「んー、私もまー、キホンまったく進んでないかもー？」","english":"“Mm, mine’s basically not moving at all either.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00017","sourceRef":"oretsuba-afterstory:23_1a:full-00017","line":18,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「だよねー、通称手つかずだよねー」","english":"“Right. The technical term is ‘untouched.’”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00018","sourceRef":"oretsuba-afterstory:23_1a:full-00018","line":19,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「えー、アレって期限いつだっけー」","english":"“Wait, when’s it due?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00019","sourceRef":"oretsuba-afterstory:23_1a:full-00019","line":20,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「さー、今週の金曜ぐらいじゃなかったー？」","english":"“Dunno. This Friday or something?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00020","sourceRef":"oretsuba-afterstory:23_1a:full-00020","line":21,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「まじでー。てか、今日何曜ー？」","english":"“Seriously? Wait, what day is today?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00021","sourceRef":"oretsuba-afterstory:23_1a:full-00021","line":22,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「えーと……きのう夕方『シジミさん』観て憂鬱ンなったから、たぶん月曜ー」","english":"“Let’s see... I watched *Shijimi* yesterday evening and got depressed, so probably Monday.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00022","sourceRef":"oretsuba-afterstory:23_1a:full-00022","line":23,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「まじだ、したらあと四日しかないし。終わるわけないじゃん、ばかじゃね？」","english":"“Oh, shit, you’re right. Then we only have four days. There’s no way we’ll finish. Are they stupid?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00023","sourceRef":"oretsuba-afterstory:23_1a:full-00023","line":24,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「だよねー、もう笑うしかないよねー」","english":"“Right? All you can do is laugh.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00024","sourceRef":"oretsuba-afterstory:23_1a:full-00024","line":25,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「むしろ笑う気力もないよね」","english":"“I don’t even have the energy to laugh.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00025","sourceRef":"oretsuba-afterstory:23_1a:full-00025","line":26,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「すでに口を開くのも億劫だよねー」","english":"“Opening my mouth is already too much work.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00026","sourceRef":"oretsuba-afterstory:23_1a:full-00026","line":27,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「なんもする気起こらんよね……」","english":"“Don’t feel like doing anything...”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00027","sourceRef":"oretsuba-afterstory:23_1a:full-00027","line":28,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「だねー……」","english":"“Same...”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00028","sourceRef":"oretsuba-afterstory:23_1a:full-00028","line":29,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「たるー……」","english":"“So tired...”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00029","sourceRef":"oretsuba-afterstory:23_1a:full-00029","line":30,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「ねむー……」","english":"“So sleepy...”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00030","sourceRef":"oretsuba-afterstory:23_1a:full-00030","line":31,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「はー……」","english":"“Sigh...”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00031","sourceRef":"oretsuba-afterstory:23_1a:full-00031","line":32,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「ふー……」","english":"“Whew...”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00032","sourceRef":"oretsuba-afterstory:23_1a:full-00032","line":33,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00033","sourceRef":"oretsuba-afterstory:23_1a:full-00033","line":34,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00034","sourceRef":"oretsuba-afterstory:23_1a:full-00034","line":35,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「……」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00035","sourceRef":"oretsuba-afterstory:23_1a:full-00035","line":36,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「……」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00036","sourceRef":"oretsuba-afterstory:23_1a:full-00036","line":37,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「てかさー」","english":"“Hey...”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00037","sourceRef":"oretsuba-afterstory:23_1a:full-00037","line":38,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「んー？」","english":"“Mmm?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00038","sourceRef":"oretsuba-afterstory:23_1a:full-00038","line":39,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「午後の体育で持久走って、ありえなくない？」","english":"“Making us do an endurance run in afternoon gym is straight-up insane, right?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00039","sourceRef":"oretsuba-afterstory:23_1a:full-00039","line":40,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「ねー、ドＳだよねー」","english":"“Yeah. Total sadists.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00040","sourceRef":"oretsuba-afterstory:23_1a:full-00040","line":41,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「今日はもう、アレでぜんぶ持ってかれたよね」","english":"“That drained everything I had today.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00041","sourceRef":"oretsuba-afterstory:23_1a:full-00041","line":42,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「根こそぎ吸われたよねー」","english":"“Sucked us completely dry.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00042","sourceRef":"oretsuba-afterstory:23_1a:full-00042","line":43,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「残んないよね」","english":"“Nothing left.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00043","sourceRef":"oretsuba-afterstory:23_1a:full-00043","line":44,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「入んないしねー」","english":"“Nothing goes in.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00044","sourceRef":"oretsuba-afterstory:23_1a:full-00044","line":45,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「漏れつづけるし」","english":"“Just keeps leaking out.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00045","sourceRef":"oretsuba-afterstory:23_1a:full-00045","line":46,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「一日終わるよねー」","english":"“Whole day’s over.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00046","sourceRef":"oretsuba-afterstory:23_1a:full-00046","line":47,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「運動部の子らとか、このあとさらに走りまわるって、も意味わかんなくない？」","english":"“How do the sports-club girls go run around even more after this? Doesn’t make any sense.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00047","sourceRef":"oretsuba-afterstory:23_1a:full-00047","line":48,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「やー、すごいよねー、あのバイタリティ。も前世タンカーとかでしょー」","english":"“Seriously, that stamina’s incredible. They were probably oil tankers in their past lives.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00048","sourceRef":"oretsuba-afterstory:23_1a:full-00048","line":49,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あ、でも鳴ちゃん、そいや元陸上部だったかも」","english":"“Oh, but Naru, weren’t you on the track team?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00049","sourceRef":"oretsuba-afterstory:23_1a:full-00049","line":50,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「あー、そんな時代もありましたなー」","english":"“Ahh, yes. Such a time once existed.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00050","sourceRef":"oretsuba-afterstory:23_1a:full-00050","line":51,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「なんで辞めたんだっけ？」","english":"“Why’d you quit again?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00051","sourceRef":"oretsuba-afterstory:23_1a:full-00051","line":52,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「んー？　んー、まー、いろいろー」","english":"“Hmm? Uh, well. Stuff.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00052","sourceRef":"oretsuba-afterstory:23_1a:full-00052","line":53,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「人間関係とか？」","english":"“People problems?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00053","sourceRef":"oretsuba-afterstory:23_1a:full-00053","line":54,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「まー」","english":"“More or less.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00054","sourceRef":"oretsuba-afterstory:23_1a:full-00054","line":55,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「けっこー深刻入ってるカンジ？」","english":"“Like, serious stuff?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00055","sourceRef":"oretsuba-afterstory:23_1a:full-00055","line":56,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「やー、んー……そーでもないですけどー」","english":"“Eh, um... Not really.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00056","sourceRef":"oretsuba-afterstory:23_1a:full-00056","line":57,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「ふーん」","english":"“Huh.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00057","sourceRef":"oretsuba-afterstory:23_1a:full-00057","line":58,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「んーと、合わない先輩がいただけー」","english":"“There was just this upperclassman I didn’t get along with.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00058","sourceRef":"oretsuba-afterstory:23_1a:full-00058","line":59,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あー、あるある」","english":"“Oh, yeah. That happens.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00059","sourceRef":"oretsuba-afterstory:23_1a:full-00059","line":60,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「でしょー？」","english":"“Right?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00060","sourceRef":"oretsuba-afterstory:23_1a:full-00060","line":61,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「うんー」","english":"“Yeah.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00061","sourceRef":"oretsuba-afterstory:23_1a:full-00061","line":62,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「ねー」","english":"“Yeah...”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00062","sourceRef":"oretsuba-afterstory:23_1a:full-00062","line":63,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「んー」","english":"“Mmm.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00063","sourceRef":"oretsuba-afterstory:23_1a:full-00063","line":64,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「……」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00064","sourceRef":"oretsuba-afterstory:23_1a:full-00064","line":65,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「……」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00065","sourceRef":"oretsuba-afterstory:23_1a:full-00065","line":66,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「あー」","english":"“Ahh.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00066","sourceRef":"oretsuba-afterstory:23_1a:full-00066","line":67,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「えー？」","english":"“Huh?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00067","sourceRef":"oretsuba-afterstory:23_1a:full-00067","line":68,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「あのー、ふと気付いちゃったんだけどー」","english":"“Um, something just occurred to me.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00068","sourceRef":"oretsuba-afterstory:23_1a:full-00068","line":69,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「うん、なにー？」","english":"“Yeah? What?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00069","sourceRef":"oretsuba-afterstory:23_1a:full-00069","line":70,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「やー、こんなとこでボーッとしてるぐらいなら、アレに取りかかった方がいいんじゃないかなーと」","english":"“If we’re just gonna sit around spacing out, shouldn’t we start working on that thing?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00070","sourceRef":"oretsuba-afterstory:23_1a:full-00070","line":71,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「なに、アレって」","english":"“What thing?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00071","sourceRef":"oretsuba-afterstory:23_1a:full-00071","line":72,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「ほら、数学のー」","english":"“You know. The math.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00072","sourceRef":"oretsuba-afterstory:23_1a:full-00072","line":73,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「ああ、個別課題……そっか、そろそろ始めなきゃ、ちょっとマズ気かもね」","english":"“Oh, the individual assignment... Yeah, we should probably start soon. This might be kinda bad.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00073","sourceRef":"oretsuba-afterstory:23_1a:full-00073","line":74,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「やー、まー、ちょっとって言うか、全然マズいよねー」","english":"“Yeah, well, more like totally screwed.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00074","sourceRef":"oretsuba-afterstory:23_1a:full-00074","line":75,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「余裕でマズいかぁ」","english":"“Screwed with room to spare, huh.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00075","sourceRef":"oretsuba-afterstory:23_1a:full-00075","line":76,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「あと４日しかないしねー」","english":"“Only four days left.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00076","sourceRef":"oretsuba-afterstory:23_1a:full-00076","line":77,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「やばいよね、遊んでる場合じゃないっていうね」","english":"“We’re screwed. This is seriously no time to mess around.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00077","sourceRef":"oretsuba-afterstory:23_1a:full-00077","line":78,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「ねー、もう一分一秒が惜しいよねー」","english":"“Right. Every minute and second is precious.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00078","sourceRef":"oretsuba-afterstory:23_1a:full-00078","line":79,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「まじで今すぐ取りからかないと手遅れってレベルじゃん」","english":"“Like, if we don’t start right this second, it’s already too late.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00079","sourceRef":"oretsuba-afterstory:23_1a:full-00079","line":80,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「そー、だって間に合わなかったら冬休み、補習でしょー」","english":"“Exactly. If we don’t finish, we get remedial lessons over winter break.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00080","sourceRef":"oretsuba-afterstory:23_1a:full-00080","line":81,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「そう、ソレひどくなーい？　こっちにも都合あんだしさー。私、冬休みバイト入れちゃってんもん」","english":"“Right! Isn’t that awful? We have lives too. I already scheduled shifts over winter break.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00081","sourceRef":"oretsuba-afterstory:23_1a:full-00081","line":82,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「えー、どーすんの、やばいじゃん。ぜったい補習ムリじゃん」","english":"“What’re you gonna do? That’s bad. You totally can’t do remedial classes.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00082","sourceRef":"oretsuba-afterstory:23_1a:full-00082","line":83,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「でしょー、だからダベってる場合じゃないんだって」","english":"“Exactly. This is no time to sit around talking.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00083","sourceRef":"oretsuba-afterstory:23_1a:full-00083","line":84,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「大変大変、もう始めた方がいいよ」","english":"“Emergency, emergency. You’d better start now.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00084","sourceRef":"oretsuba-afterstory:23_1a:full-00084","line":85,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「え、鳴ちゃんは始めないの？　帰って家でやる系？」","english":"“Wait, you’re not starting? You gonna do yours at home?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00085","sourceRef":"oretsuba-afterstory:23_1a:full-00085","line":86,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「あー……あー、そうねー、今日はもう家でやろうかなあ、的な」","english":"“Uh... Yeah, maybe I’ll do it at home today. Something like that.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00086","sourceRef":"oretsuba-afterstory:23_1a:full-00086","line":87,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「つって、家帰って勉強とか、やった試しないよね」","english":"“You say that, but you’ve never once gone home and studied.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00087","sourceRef":"oretsuba-afterstory:23_1a:full-00087","line":88,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「家は魔物棲んでるんだなー」","english":"“My house is full of demons.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00088","sourceRef":"oretsuba-afterstory:23_1a:full-00088","line":89,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「魔物ねー、おるおる、テレビとか雑誌とかに」","english":"“Demons, yeah. The TV and magazines are full of them.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00089","sourceRef":"oretsuba-afterstory:23_1a:full-00089","line":90,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「おるでしょー、ネットとかゲームとかに」","english":"“Right? The internet and games too.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00090","sourceRef":"oretsuba-afterstory:23_1a:full-00090","line":91,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「も、あらゆる魔が潜んでるよね」","english":"“Every kind of evil lurks there.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00091","sourceRef":"oretsuba-afterstory:23_1a:full-00091","line":92,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「もはや伏魔殿だよねー」","english":"“It’s practically a demon palace.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00092","sourceRef":"oretsuba-afterstory:23_1a:full-00092","line":93,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「じゃあ、鳴ちゃんも残ってやってく系？」","english":"“So you’re staying to do it too?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00093","sourceRef":"oretsuba-afterstory:23_1a:full-00093","line":94,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「まー、それが現実的かなー」","english":"“Yeah, that’s probably the realistic choice.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00094","sourceRef":"oretsuba-afterstory:23_1a:full-00094","line":95,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「そーそ。もういい加減、現実逃避してるトキじゃないし」","english":"“Right, right. We seriously can’t keep avoiding reality.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00095","sourceRef":"oretsuba-afterstory:23_1a:full-00095","line":96,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「じゃー亜衣ちゃん先始めていいよー」","english":"“Okay, you can start first, Ai.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00096","sourceRef":"oretsuba-afterstory:23_1a:full-00096","line":97,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「いや鳴ちゃん先始めていいってー」","english":"“No, no, you start first, Naru.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00097","sourceRef":"oretsuba-afterstory:23_1a:full-00097","line":98,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「いやいや香田亜衣が」","english":"“No, no, Ai Kouda should.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00098","sourceRef":"oretsuba-afterstory:23_1a:full-00098","line":99,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「いやいや鳳鳴が」","english":"“No, no, Naru Ohtori should.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00099","sourceRef":"oretsuba-afterstory:23_1a:full-00099","line":100,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「じゃ生まれ月の順で、亜衣ちゃん先に」","english":"“Then by birth month. Ai first.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00100","sourceRef":"oretsuba-afterstory:23_1a:full-00100","line":101,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「いやいや、出席番号順で鳳さん先に」","english":"“No, no. Attendance order. Miss Ohtori first.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00101","sourceRef":"oretsuba-afterstory:23_1a:full-00101","line":102,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「じゃ、背ぇ高い順で亜衣ちゃんから」","english":"“Then by height. Tallest first, so Ai.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00102","sourceRef":"oretsuba-afterstory:23_1a:full-00102","line":103,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「え、背の順って、フツー小さい方が前じゃね？」","english":"“Wait, by height usually means shortest first, doesn’t it?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00103","sourceRef":"oretsuba-afterstory:23_1a:full-00103","line":104,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「あーそっか、じゃー胸囲順で。小さい方が前に」","english":"“Oh, right. Then by bust measurement. Smallest first.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00104","sourceRef":"oretsuba-afterstory:23_1a:full-00104","line":105,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「うん。なら鳴ちゃん前だよね」","english":"“Okay. That makes Naru first.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00105","sourceRef":"oretsuba-afterstory:23_1a:full-00105","line":106,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「なんで？」","english":"“Why?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00106","sourceRef":"oretsuba-afterstory:23_1a:full-00106","line":107,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「なんでとかじゃなくて。見たまんまフツーにそうじゃん」","english":"“What do you mean, why? One look makes it obvious.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00107","sourceRef":"oretsuba-afterstory:23_1a:full-00107","line":108,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「いや、亜衣ちゃんいつも底上げしてるからじゃん」","english":"“That’s only because you’re always boosting yours.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00108","sourceRef":"oretsuba-afterstory:23_1a:full-00108","line":109,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「上げってほど上げてないって。若干ガードしっかりめなだけだよ」","english":"“I don’t boost them that much. I just wear slightly heavier armor.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00109","sourceRef":"oretsuba-afterstory:23_1a:full-00109","line":110,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「えー、じゃカップ何？」","english":"“Oh, yeah? What cup?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00110","sourceRef":"oretsuba-afterstory:23_1a:full-00110","line":111,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「Ｄ」","english":"“D.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00111","sourceRef":"oretsuba-afterstory:23_1a:full-00111","line":112,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「あ、同じ同じー」","english":"“Oh, same as you.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00112","sourceRef":"oretsuba-afterstory:23_1a:full-00112","line":113,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「嘘じゃん」","english":"“Liar.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00113","sourceRef":"oretsuba-afterstory:23_1a:full-00113","line":114,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「おまえもな」","english":"“Right back at you.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00114","sourceRef":"oretsuba-afterstory:23_1a:full-00114","line":115,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「鳴ちゃんＢだし」","english":"“You’re a B, Naru.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00115","sourceRef":"oretsuba-afterstory:23_1a:full-00115","line":116,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「亜衣ちゃん６５のＢでしょ。私６５Ｃだもん」","english":"“And you’re a 65B. I’m a 65C.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00116","sourceRef":"oretsuba-afterstory:23_1a:full-00116","line":117,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「嘘・テイク２じゃん」","english":"“Lie: Take Two.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00117","sourceRef":"oretsuba-afterstory:23_1a:full-00117","line":118,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「まじまじー」","english":"“It’s true.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00118","sourceRef":"oretsuba-afterstory:23_1a:full-00118","line":119,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「ないって、そんな。ちょ、触らしてみ」","english":"“No way. Let me feel.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00119","sourceRef":"oretsuba-afterstory:23_1a:full-00119","line":120,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「オプション料金」","english":"“That costs extra.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00120","sourceRef":"oretsuba-afterstory:23_1a:full-00120","line":121,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「ガムあげる」","english":"“I’ll give you gum.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00121","sourceRef":"oretsuba-afterstory:23_1a:full-00121","line":122,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「どうぞ」","english":"“Go ahead.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00122","sourceRef":"oretsuba-afterstory:23_1a:full-00122","line":123,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「では失礼……ふんふん、なるほどこれは……」","english":"“Pardon me... Hmm, hmm. I see...”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00123","sourceRef":"oretsuba-afterstory:23_1a:full-00123","line":124,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「どうよ」","english":"“Well?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00124","sourceRef":"oretsuba-afterstory:23_1a:full-00124","line":125,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「んー……普通？」","english":"“Mm... Normal?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00125","sourceRef":"oretsuba-afterstory:23_1a:full-00125","line":126,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「普通て」","english":"“What do you mean, normal?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00126","sourceRef":"oretsuba-afterstory:23_1a:full-00126","line":127,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「じゃあ、やーらかい」","english":"“Okay, soft.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00127","sourceRef":"oretsuba-afterstory:23_1a:full-00127","line":128,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「それでいて弾力もあるのよ？」","english":"“Yet springy too, yes?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00128","sourceRef":"oretsuba-afterstory:23_1a:full-00128","line":129,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「てかこのブラ、ワイヤーきつくね？」","english":"“Isn’t the underwire on this bra kinda tight?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00129","sourceRef":"oretsuba-afterstory:23_1a:full-00129","line":130,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「デザイン重視でー」","english":"“I prioritize design.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00130","sourceRef":"oretsuba-afterstory:23_1a:full-00130","line":131,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「おっ、下から揺らすとなんかえろい」","english":"“Ooh, it looks kinda sexy if I bounce them from underneath.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00131","sourceRef":"oretsuba-afterstory:23_1a:full-00131","line":132,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「ノーノー、先端禁止、先端禁止」","english":"“No, no. Nipples are off-limits. Nipples are off-limits.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00132","sourceRef":"oretsuba-afterstory:23_1a:full-00132","line":133,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「え、いま当たった？」","english":"“Wait, did I touch one?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00133","sourceRef":"oretsuba-afterstory:23_1a:full-00133","line":134,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「容疑者は小指です」","english":"“The suspect is your pinky.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00134","sourceRef":"oretsuba-afterstory:23_1a:full-00134","line":135,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「ウソどこ？　ここ？」","english":"“Really? Where? Here?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00135","sourceRef":"oretsuba-afterstory:23_1a:full-00135","line":136,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「触んな、ッちゅーのー」","english":"“I said don’t touch it.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00136","sourceRef":"oretsuba-afterstory:23_1a:full-00136","line":137,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「感じる？」","english":"“Does it feel good?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00137","sourceRef":"oretsuba-afterstory:23_1a:full-00137","line":138,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「じない」","english":"“No.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00138","sourceRef":"oretsuba-afterstory:23_1a:full-00138","line":139,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「声出せ声」","english":"“Make some noise.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00139","sourceRef":"oretsuba-afterstory:23_1a:full-00139","line":140,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「ひぎぃー、ひぎぃー」","english":"“Higiii! Higiii!”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00140","sourceRef":"oretsuba-afterstory:23_1a:full-00140","line":141,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「お？　お？　なんかこのフニ感、楽しくなってきたかも」","english":"“Ooh? Ooh? This squishy feeling’s starting to get fun.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00141","sourceRef":"oretsuba-afterstory:23_1a:full-00141","line":142,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「まじすか。え、そっちのもフニらせれ」","english":"“Seriously? Then lemme squish yours.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00142","sourceRef":"oretsuba-afterstory:23_1a:full-00142","line":143,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「つって、もうフニってんじゃん」","english":"“You already are.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00143","sourceRef":"oretsuba-afterstory:23_1a:full-00143","line":144,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「ほー……ほうほう、なるほどこの手触りは……」","english":"“Ooh... Hmm, hmm. I see. This texture...”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00144","sourceRef":"oretsuba-afterstory:23_1a:full-00144","line":145,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「どうよ」","english":"“Well?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00145","sourceRef":"oretsuba-afterstory:23_1a:full-00145","line":146,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「厚い」","english":"“Thick.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00146","sourceRef":"oretsuba-afterstory:23_1a:full-00146","line":147,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「厚い言うな。てめえ、こね回してやる」","english":"“Don’t call them thick. I’m gonna knead yours to pieces.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00147","sourceRef":"oretsuba-afterstory:23_1a:full-00147","line":148,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「負けない、揉みしだいてやる」","english":"“Bring it. I’ll squeeze yours flat.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00148","sourceRef":"oretsuba-afterstory:23_1a:full-00148","line":149,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「あっ……ちょ、待って待って、くすぐったい。なんかやばい」","english":"“Ah... Wait, wait. That tickles. This is getting bad.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00149","sourceRef":"oretsuba-afterstory:23_1a:full-00149","line":150,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「わー、感度いいぶってるー」","english":"“Ooh, pretending you’re sensitive.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00150","sourceRef":"oretsuba-afterstory:23_1a:full-00150","line":151,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「らめぇー、らめぇー」","english":"“Nooo, nooo.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00151","sourceRef":"oretsuba-afterstory:23_1a:full-00151","line":152,"speakerJa":"女子Ａ","speakerEn":"Girl A","japanese":"「あの……さっきから何やってんの、あんたら……」","english":"“Um... What have you two been doing all this time...?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00152","sourceRef":"oretsuba-afterstory:23_1a:full-00152","line":153,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「えー？　現実逃避ー」","english":"“What? Avoiding reality.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00153","sourceRef":"oretsuba-afterstory:23_1a:full-00153","line":154,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「言っちゃった」","english":"“She admitted it.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00154","sourceRef":"oretsuba-afterstory:23_1a:full-00154","line":155,"speakerJa":"女子Ａ","speakerEn":"Girl A","japanese":"「数学の……特別課題？　っての、もう終わったん？」","english":"“Did you finish that... special math assignment?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00155","sourceRef":"oretsuba-afterstory:23_1a:full-00155","line":156,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「いや、それが不思議なことに、ぜんぜん終わんなくて」","english":"“No. Strangely enough, it’s not finished at all.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00156","sourceRef":"oretsuba-afterstory:23_1a:full-00156","line":157,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「どころか、ぜんぜん始まんないんだよねー」","english":"“It hasn’t even started at all.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00157","sourceRef":"oretsuba-afterstory:23_1a:full-00157","line":158,"speakerJa":"女子Ａ","speakerEn":"Girl A","japanese":"「あ、そう……じゃあ、がんばって……」","english":"“Oh... Well, good luck...”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00158","sourceRef":"oretsuba-afterstory:23_1a:full-00158","line":159,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「ありがとー」","english":"“Thanks.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00159","sourceRef":"oretsuba-afterstory:23_1a:full-00159","line":160,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「ばいばーい」","english":"“Bye-bye.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00160","sourceRef":"oretsuba-afterstory:23_1a:full-00160","line":161,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00161","sourceRef":"oretsuba-afterstory:23_1a:full-00161","line":162,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00162","sourceRef":"oretsuba-afterstory:23_1a:full-00162","line":163,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「……でー、なんの話だっけー？」","english":"“...So what were we talking about?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00163","sourceRef":"oretsuba-afterstory:23_1a:full-00163","line":164,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「えーと、乳首の位置？」","english":"“Um, nipple placement?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00164","sourceRef":"oretsuba-afterstory:23_1a:full-00164","line":165,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「ちがうでしょー、勉強しよって話だよー」","english":"“No, studying.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00165","sourceRef":"oretsuba-afterstory:23_1a:full-00165","line":166,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「そんなんしてたっけ？」","english":"“Were we talking about that?”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00166","sourceRef":"oretsuba-afterstory:23_1a:full-00166","line":167,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「してないかな」","english":"“Maybe not.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00167","sourceRef":"oretsuba-afterstory:23_1a:full-00167","line":168,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「してなくね？」","english":"“Pretty sure we weren’t.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00168","sourceRef":"oretsuba-afterstory:23_1a:full-00168","line":169,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「だよね、してないよねー。じゃあいいや帰ろーきゃっほー！」","english":"“Right, we weren’t. Then never mind. Let’s go home! Woo-hoo!”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00169","sourceRef":"oretsuba-afterstory:23_1a:full-00169","line":170,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「ってわけにはいかない系だよねー」","english":"“Except we can’t, huh.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00170","sourceRef":"oretsuba-afterstory:23_1a:full-00170","line":171,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「ま、さすがに今日はねー、やらなきゃなんない系だよねー」","english":"“Yeah, today we seriously have to do it.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00171","sourceRef":"oretsuba-afterstory:23_1a:full-00171","line":172,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「しゃーない、もお。腹くくって始めるし」","english":"“Fine. I’ll bite the bullet and start.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00172","sourceRef":"oretsuba-afterstory:23_1a:full-00172","line":173,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「ですなー」","english":"“Indeed.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00173","sourceRef":"oretsuba-afterstory:23_1a:full-00173","line":174,"speakerJa":"亜衣","speakerEn":"Ai","japanese":"「じゃあ期末テストの成績イイ順で、鳴ちゃんから先」","english":"“Okay, best final-exam grades first. Naru, you start.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00174","sourceRef":"oretsuba-afterstory:23_1a:full-00174","line":175,"speakerJa":"鳴","speakerEn":"Naru","japanese":"「いやいやー、ここはマラソン大会の成績イイ順で亜衣ちゃんから」","english":"“No, no. Best marathon time first. Ai, you start.”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00175","sourceRef":"oretsuba-afterstory:23_1a:full-00175","line":176,"speakerJa":"","speakerEn":"","japanese":"「………………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00176","sourceRef":"oretsuba-afterstory:23_1a:full-00176","line":177,"speakerJa":"","speakerEn":"","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-23_1a:full-00177","sourceRef":"oretsuba-afterstory:23_1a:full-00177","line":178,"speakerJa":"","speakerEn":"","japanese":"「……」","english":"“...”"}]}

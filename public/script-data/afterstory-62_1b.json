{"route":"afterstory","routeLabel":"AfterStory","scriptId":"afterstory-62_1b","lineCount":15,"lines":[{"ref":"oretsuba:afterstory:afterstory-62_1b:full-00000","sourceRef":"oretsuba-afterstory:62_1b:full-00000","line":1,"speakerJa":"鷲介","speakerEn":"Shuusuke","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-62_1b:full-00001","sourceRef":"oretsuba-afterstory:62_1b:full-00001","line":2,"speakerJa":"日和子","speakerEn":"Hiyoko","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-62_1b:full-00002","sourceRef":"oretsuba-afterstory:62_1b:full-00002","line":3,"speakerJa":"","speakerEn":"","japanese":"やがて外からは何の音も聞こえてこなくなりました。","english":"Eventually, not a sound could be heard outside."},{"ref":"oretsuba:afterstory:afterstory-62_1b:full-00003","sourceRef":"oretsuba-afterstory:62_1b:full-00003","line":4,"speakerJa":"日和子","speakerEn":"Hiyoko","japanese":"「鷲介さん」","english":"“Shuusuke.”"},{"ref":"oretsuba:afterstory:afterstory-62_1b:full-00004","sourceRef":"oretsuba-afterstory:62_1b:full-00004","line":5,"speakerJa":"鷲介","speakerEn":"Shuusuke","japanese":"「はい」","english":"“Yes?”"},{"ref":"oretsuba:afterstory:afterstory-62_1b:full-00005","sourceRef":"oretsuba-afterstory:62_1b:full-00005","line":6,"speakerJa":"日和子","speakerEn":"Hiyoko","japanese":"「もう、外に誰もいないんじゃないですか？」","english":"“Don’t you think everyone has left?”"},{"ref":"oretsuba:afterstory:afterstory-62_1b:full-00006","sourceRef":"oretsuba-afterstory:62_1b:full-00006","line":7,"speakerJa":"鷲介","speakerEn":"Shuusuke","japanese":"「まだまだ。もう少し様子をみましょう」","english":"“Not yet. We should wait and see a little longer.”"},{"ref":"oretsuba:afterstory:afterstory-62_1b:full-00007","sourceRef":"oretsuba-afterstory:62_1b:full-00007","line":8,"speakerJa":"日和子","speakerEn":"Hiyoko","japanese":"「そうですか」","english":"“All right.”"},{"ref":"oretsuba:afterstory:afterstory-62_1b:full-00008","sourceRef":"oretsuba-afterstory:62_1b:full-00008","line":9,"speakerJa":"鷲介","speakerEn":"Shuusuke","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-62_1b:full-00009","sourceRef":"oretsuba-afterstory:62_1b:full-00009","line":10,"speakerJa":"日和子","speakerEn":"Hiyoko","japanese":"「…………」","english":"“...”"},{"ref":"oretsuba:afterstory:afterstory-62_1b:full-00010","sourceRef":"oretsuba-afterstory:62_1b:full-00010","line":11,"speakerJa":"日和子","speakerEn":"Hiyoko","japanese":"「あの、やっぱり」","english":"“Um, I really think...”"},{"ref":"oretsuba:afterstory:afterstory-62_1b:full-00011","sourceRef":"oretsuba-afterstory:62_1b:full-00011","line":12,"speakerJa":"鷲介","speakerEn":"Shuusuke","japanese":"「なんですか。隠れてるんだから、あんまり声出さない方がいいですよ」","english":"“What is it? We’re hiding, so you shouldn’t speak too loudly.”"},{"ref":"oretsuba:afterstory:afterstory-62_1b:full-00012","sourceRef":"oretsuba-afterstory:62_1b:full-00012","line":13,"speakerJa":"日和子","speakerEn":"Hiyoko","japanese":"「そ、そうなんですけど」","english":"“I-I know, but...”"},{"ref":"oretsuba:afterstory:afterstory-62_1b:full-00013","sourceRef":"oretsuba-afterstory:62_1b:full-00013","line":14,"speakerJa":"日和子","speakerEn":"Hiyoko","japanese":"「ちょっと、距離が近すぎるって言うか……」","english":"“We’re standing a little too close...”"},{"ref":"oretsuba:afterstory:afterstory-62_1b:full-00014","sourceRef":"oretsuba-afterstory:62_1b:full-00014","line":15,"speakerJa":"","speakerEn":"","japanese":"はい。おっしゃる通りです。","english":"Yes. You are entirely correct."}]}
